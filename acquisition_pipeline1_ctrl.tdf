include "counter.inc";
include "dffes.inc";

PARAMETERS
(
		samples = 3
);

CONSTANT samples_n_bits = LOG2(samples-1);	

subdesign acquisition_pipeline1_ctrl(
	clk: INPUT;				-- Clock principal
	sreset: input;

	store: input;

	store_crc:output;
	store_crc_ok:input;
	
	store_time_counter: output;
	store_time_counter_ok:input;
	
	samples_counter[samples_n_bits-1..0]: input;
	
	busy: output;

	time_counter_restart: output;
)
variable
	sm: MACHINE WITH STATES (WAITING_STORING, STORING_TIME_COUNTER, STORING_CRC);
	store_ff, store_crc_ff, store_time_counter_ff, busy_ff: dffes;
	busy_d: node;
begin
	defaults
		store_ff.d = Gnd;
		store_crc_ff.d = Gnd;
		store_time_counter_ff.d = Gnd;
		busy_d = Vcc;
		crc_clr = Gnd;
	end defaults;


	store_ff.clk = clk;
	store_crc_ff.clk = clk;
	store_time_counter_ff.clk = clk;
	busy_ff.clk = clk;

	sm.clk = clk;
	sm.reset = sreset;
	store_ff.sclr = sreset;
	store_crc_ff.sclr = sreset;
	store_time_counter_ff.sclr = sreset;
	busy_ff.sclr = sreset;
	
	case sm is
		when WAITING_STORING =>
test_sm_state[] = 0;
			if !start_sync.q then
				sm = WAITING_START_HIGH;
			else
				sm = WAITING_START_LOW;
			end if;
		when WAITING_START_HIGH =>
test_sm_state[] = 1;
			samples_counter.clr = Vcc;
			clock_counter.clr = Vcc;	-- Contador parado enquanto não há start
			if start_sync.q then
				convst_ff.d = Vcc;
				addr_clr = Vcc;
				crc_clr = Vcc;
				time_counter_restart = Vcc;
				sm = AQUISITIONING;
			else
				busy_d = Gnd;
				sm = WAITING_START_HIGH;
			end if;

		when AQUISITIONING =>
test_sm_state[] = 2;
			clock_counter.inc = Vcc;
			if clock_counter.o[] == active_period-1 then
				sm = WAIT_STATE;
			else
				convst_ff.d = Vcc;
				sm = AQUISITIONING;
			end if;
			
		when WAIT_STATE =>
test_sm_state[] = 3;
			clock_counter.inc = Vcc;
			sm = SERIALIZING;
			serialize_ff.d = Vcc;
			
		when SERIALIZING =>
test_sm_state[] = 4;
			if serialize_ok then
				store_ff.d = Vcc;
				sm = STORING;
			else
				serialize_ff.d = Vcc;
				sm = SERIALIZING;
			end if;
		
		when STORING =>
test_sm_state[] = 5;
			if store_ok then
				sm = WAITING_END_OF_CYCLE;
				samples_counter.inc = Vcc;
			else
				store_ff.d = Vcc;
				sm = STORING;
			end if;
			
		when WAITING_END_OF_CYCLE =>
test_sm_state[] = 6;
			if samples_counter.o[] == samples then
				samples_counter.clr = Vcc; -- Zera o contador de amostras
				clock_counter.clr = Vcc;	-- Reinicia o contador
				store_time_counter_ff.d = Vcc;
				sm = STORING_TIME_COUNTER;
			else
				if clock_counter.o[] == period-1 then
					clock_counter.clr = Vcc;	-- Reinicia o contador
					convst_ff.d = Vcc; -- Liga o convst
					sm = AQUISITIONING;
				end if;
			end if;
			
		when STORING_TIME_COUNTER =>
test_sm_state[] = 7;
			if store_time_counter_ok then
				store_crc_ff.d = Vcc;
				sm = STORING_CRC;
			else
				store_time_counter_ff.d = Vcc;
				sm = STORING_TIME_COUNTER;
			end if;
			
		when STORING_CRC =>
test_sm_state[] = 8;
			if store_crc_ok then
				busy_d = Gnd;
				sm = WAITING_START_LOW;
			else
				store_crc_ff.d = Vcc;
				sm = STORING_CRC;
			end if;
	end case;
	
	convst = convst_ff.q;
	serialize = serialize_ff.q;
	store = store_ff.q;
	busy_ff.d = busy_d;
	busy = busy_ff.q;
	store_crc = store_crc_ff.q;
	store_time_counter = store_time_counter_ff.q;

-- TESTES ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	test_clock_counter[] = clock_counter.o[];
	test_samples_counter[] = samples_counter.o[];
end;


