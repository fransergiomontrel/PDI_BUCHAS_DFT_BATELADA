
include "DFT.inc";

subdesign dft_locale(
   
	tx_status: input;
	clk: input;
	sreset: input;
	word[15..0]: input;
	
	luts_value[31..0]: input;
	
	await_lut: input;
	
	sin_out1[31..0]: output;
	cos_out1[31..0]: output;
	sin_out2[31..0]: output;
	cos_out2[31..0]: output;
	sin_out3[31..0]: output;
	cos_out3[31..0]: output;
	sin_out4[31..0]: output;
	cos_out4[31..0]: output;
	sin_out5[31..0]: output;
	cos_out5[31..0]: output;
	sin_out6[31..0]: output;
	cos_out6[31..0]: output;
	
	start_tx: output;
	end_tx: input;
	debug: output;
	debug_res: output;
	luts_addr_out[12..0]: output;
		
)

variable

    sm: machine with states(first_sample, tx_begin, nop, start_dft, on_dft, on_dft2, sum_dft, back_start, await_tx_high);
	 
	 tx_status_ff, await_lut_ff: dff;
	 channel_number[2..0],out_reg[15..0], sample_counter[12..0]: dffe;
	 lut_index[12..0]: node;
	 lut_index_plus1[12..0]: node;
	 lut_addr[12..0]: node;
	 dft_by_word1, dft_by_word2, dft_by_word3, dft_by_word4, dft_by_word5, dft_by_word6 : DFT;	  

begin
		 	 
    defaults  	

		  dft_by_word1.start_dft = Gnd;
		  dft_by_word2.start_dft = Gnd;
		  dft_by_word3.start_dft = Gnd;
		  dft_by_word4.start_dft = Gnd;
		  dft_by_word5.start_dft = Gnd;
		  dft_by_word6.start_dft = Gnd;
		
		  sample_counter[].ena = Gnd;
		  --Only specific states can increment channel_number or clean it
		  channel_number[].ena = Gnd;
		  
	 end defaults;
	 
	 --Counter of samples
    sample_counter[].clk = clk;
	 sample_counter[].d = sample_counter[].q + 1;
	 sample_counter[].clrn = !sreset & !end_tx;
	
	 if sample_counter[].q <= 3607 then
	 
	     lut_index[] = sample_counter[].q;
	 
	 else
	 
	     lut_index[] = 7214 - sample_counter[].q;
		  
	 end if;
	 
	 lut_index_plus1[] = lut_index[] + 1;
	 lut_addr[0] = Gnd;
	 lut_addr[12..1] = lut_index_plus1[11..0];
	 luts_addr_out[] = lut_addr[];
	 
	 debug = start_tx;
	 
	 
	 debug_res = channel_number[1].q;
	 
	 
	 tx_status_ff.clk = clk;
	 tx_status_ff.clrn = !sreset;
	 tx_status_ff.d = tx_status;
	 
	 --Only specific states can increment channel_number or clean it
	channel_number[].clk = clk;
	channel_number[].clrn = !sreset;
	channel_number[].d = channel_number[].q + 1;
	 
	 --DFT permanent connections
	 dft_by_word1.clk = clk;
	 dft_by_word1.reset = sreset;
	 dft_by_word1.read_sample[] = word[];
	 dft_by_word1.luts_dft_in[] = luts_value[];
	 dft_by_word1.end_tx = end_tx;
	 dft_by_word1.sample_counter[] = sample_counter[].q;
	 
	 sin_out1[] = dft_by_word1.sin_out[];
	 cos_out1[] = dft_by_word1.cos_out[];
	 
	 dft_by_word2.clk = clk;
	 dft_by_word2.reset = sreset;
	 dft_by_word2.read_sample[] = word[];
	 dft_by_word2.luts_dft_in[] = luts_value[];
	 dft_by_word2.end_tx = end_tx;
	 dft_by_word2.sample_counter[] = sample_counter[].q;
	 
	 sin_out2[] = dft_by_word2.sin_out[];
	 cos_out2[] = dft_by_word2.cos_out[];
	 
	 dft_by_word3.clk = clk;
	 dft_by_word3.reset = sreset;
	 dft_by_word3.read_sample[] = word[];
	 dft_by_word3.luts_dft_in[] = luts_value[];
	 dft_by_word3.end_tx = end_tx;
	 dft_by_word3.sample_counter[] = sample_counter[].q;
	 
	 sin_out3[] = dft_by_word3.sin_out[];
	 cos_out3[] = dft_by_word3.cos_out[];
	 
	 dft_by_word4.clk = clk;
	 dft_by_word4.reset = sreset;
	 dft_by_word4.read_sample[] = word[];
	 dft_by_word4.luts_dft_in[] = luts_value[];
	 dft_by_word4.end_tx = end_tx;
	 dft_by_word4.sample_counter[] = sample_counter[].q;
	 
	 sin_out4[] = dft_by_word4.sin_out[];
	 cos_out4[] = dft_by_word4.cos_out[];
	 
	 dft_by_word5.clk = clk;
	 dft_by_word5.reset = sreset;
	 dft_by_word5.read_sample[] = word[];
	 dft_by_word5.luts_dft_in[] = luts_value[];
	 dft_by_word5.end_tx = end_tx;
	 dft_by_word5.sample_counter[] = sample_counter[].q;
	 
	 sin_out5[] = dft_by_word5.sin_out[];
	 cos_out5[] = dft_by_word5.cos_out[];
	 
	 dft_by_word6.clk = clk;
	 dft_by_word6.reset = sreset;
	 dft_by_word6.read_sample[] = word[];
	 dft_by_word6.luts_dft_in[] = luts_value[];
	 start_tx = dft_by_word1.start_tx & dft_by_word2.start_tx & dft_by_word3.start_tx & dft_by_word4.start_tx & dft_by_word5.start_tx & dft_by_word6.start_tx;
	 dft_by_word6.end_tx = end_tx;
	 dft_by_word6.sample_counter[] = sample_counter[].q;
	 
	 sin_out6[] = dft_by_word6.sin_out[];
	 cos_out6[] = dft_by_word6.cos_out[];
	 
	 --Clock of output register
	 out_reg[].clk = clk;
	 
	 --Inputs of state machine
	 sm.clk = clk;
	 sm.reset = sreset; 
	 
	 
    case sm is
	 
        when first_sample =>	 
						    
		      sm = nop;
				
					 
			when tx_begin =>
						
			       if !tx_status_ff.q  then
					      
				        sm = nop;
			       
					 else  
					     
				        sm = tx_begin;
			       
				    end if;	
					 		
		  when nop =>
				
            if await_lut then
					 
			       sm = start_dft;
					 
			   else
				    
			       sm = nop;
					 
			   end if;
			
		  when start_dft =>
				 		
				if channel_number[] == B"000" then
					 dft_by_word1.start_dft = Vcc;
				elsif channel_number[] == B"001" then 
					 dft_by_word2.start_dft = Vcc;
				elsif channel_number[] == B"010" then 
					 dft_by_word3.start_dft = Vcc;
				elsif channel_number[] == B"011" then 
					 dft_by_word4.start_dft = Vcc;
				elsif channel_number[] == B"100" then 
					 dft_by_word5.start_dft = Vcc;
				elsif channel_number[] == B"101" then 
					 dft_by_word6.start_dft = Vcc;
				end if;
						  
			   sm = on_dft;
				 
		  when on_dft =>
		       
				sm = on_dft2;
				
		  when on_dft2 =>
		      
				sm = sum_dft;
				
		  when sum_dft =>
				
				if channel_number[] == B"000" then
					 
					 sm = await_tx_high;
					 channel_number[].ena = Vcc;
					 
				elsif channel_number[] == B"001" then 
					 
					 sm = await_tx_high;
					 channel_number[].ena = Vcc;
					 
				elsif channel_number[] == B"010" then 
					 
					 
					 channel_number[].ena = Vcc;
					 sm = await_tx_high;
					 
				elsif channel_number[] == B"011" then 
					 
					 sm = await_tx_high; 
					 channel_number[].ena = Vcc;
					 
				elsif channel_number[] == B"100" then 
					 
					 sm = await_tx_high;
					 channel_number[].ena = Vcc;
					 
				elsif channel_number[] == B"101" then 
					 
					 sm = back_start;
					 
					 channel_number[].ena = Vcc;
					 
				end if;
				
				
	when back_start =>

    	if channel_number[] != B"000" then 
					 
			sm = back_start;
			channel_number[].ena = Vcc;	 
					
		else
		    sample_counter[].ena = Vcc;
		    sm = await_tx_high;
		
		end if;
	
	when await_tx_high =>
		
		 if tx_status_ff.q then
		    
		     sm = tx_begin;
			  
		else  
					     
		   sm = await_tx_high;
			       
			
		 end if;
		     
	
    end case;
	
end;