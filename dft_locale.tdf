include "edge_detector.inc";
include "DFT.inc";

subdesign dft_locale(

	clk: input;
	sreset: input;
	byte_channel[7..0]: input;
	new_byte: input;
	
	enable_read: input;
	luts_value[31..0]: input;
	sample_word[15..0]: output;
	
	sin_out1[31..0]: output;
	cos_out1[31..0]: output;
	sin_out2[31..0]: output;
	cos_out2[31..0]: output;
	sin_out3[31..0]: output;
	cos_out3[31..0]: output;
	sin_out4[31..0]: output;
	cos_out4[31..0]: output;
	sin_out5[31..0]: output;
	cos_out5[31..0]: output;
	sin_out6[31..0]: output;
	cos_out6[31..0]: output;
	
	step_ufm_addr[12..0]: output;
	
	start_tx: output;
	end_tx: input;
		
)
variable

    sm: machine with states(idle, nop, load, load_dft, calculus_dft, sum_dft);
	 count_nop[1..0], channel_number[2..0] , byte_counter_ff, first_byte,first_sample_ff, next_step_all_ff: dff;
	 out_reg_MSB[7..0], out_reg_LSB[7..0]: dffe;
	 detect_rising: edge_detector;
	 dft_by_word1, dft_by_word2, dft_by_word3, dft_by_word4, dft_by_word5, dft_by_word6 : DFT;	  

begin
		 	 
    defaults
	 
  	     count_nop[].clrn = Gnd;   	
	     out_reg_MSB[].ena = Gnd;
		  out_reg_LSB[].ena = Gnd;
		  dft_by_word1.start_dft = Gnd;
		  dft_by_word2.start_dft = Gnd;
		  dft_by_word3.start_dft = Gnd;
		  dft_by_word4.start_dft = Gnd;
		  dft_by_word5.start_dft = Gnd;
		  dft_by_word6.start_dft = Gnd;
		  
		  next_step_all_ff.d = Gnd;
		  
		  --Only specific states can increment channel_number or clean it
		  channel_number[].clk = Gnd;
		  channel_number[].clrn = Vcc;
		  
	 end defaults;
	 
	 --DFT permanent connections
	 dft_by_word1.clk = clk;
	 dft_by_word1.reset = sreset;
	 dft_by_word1.read_sample[] = sample_word[];
	 dft_by_word1.luts_dft_in[] = luts_value[];
	 dft_by_word1.end_tx = end_tx;
	 
	 sin_out1[] = dft_by_word1.sin_out[];
	 cos_out1[] = dft_by_word1.cos_out[];
	 
	 dft_by_word2.clk = clk;
	 dft_by_word2.reset = sreset;
	 dft_by_word2.read_sample[] = sample_word[];
	 dft_by_word2.luts_dft_in[] = luts_value[];
	 dft_by_word2.end_tx = end_tx;
	 
	 sin_out2[] = dft_by_word2.sin_out[];
	 cos_out2[] = dft_by_word2.cos_out[];
	 
	 dft_by_word3.clk = clk;
	 dft_by_word3.reset = sreset;
	 dft_by_word3.read_sample[] = sample_word[];
	 dft_by_word3.luts_dft_in[] = luts_value[];
	 dft_by_word3.end_tx = end_tx;
	 
	 sin_out3[] = dft_by_word3.sin_out[];
	 cos_out3[] = dft_by_word3.cos_out[];
	 
	 dft_by_word4.clk = clk;
	 dft_by_word4.reset = sreset;
	 dft_by_word4.read_sample[] = sample_word[];
	 dft_by_word4.luts_dft_in[] = luts_value[];
	 dft_by_word4.end_tx = end_tx;
	 
	 sin_out4[] = dft_by_word4.sin_out[];
	 cos_out4[] = dft_by_word4.cos_out[];
	 
	 dft_by_word5.clk = clk;
	 dft_by_word5.reset = sreset;
	 dft_by_word5.read_sample[] = sample_word[];
	 dft_by_word5.luts_dft_in[] = luts_value[];
	 dft_by_word5.end_tx = end_tx;
	 
	 sin_out5[] = dft_by_word5.sin_out[];
	 cos_out5[] = dft_by_word5.cos_out[];
	 
	 dft_by_word6.clk = clk;
	 dft_by_word6.reset = sreset;
	 dft_by_word6.read_sample[] = sample_word[];
	 dft_by_word6.luts_dft_in[] = luts_value[];
	 start_tx = dft_by_word6.start_tx;
	 dft_by_word6.end_tx = end_tx;
	 
	 sin_out6[] = dft_by_word6.sin_out[];
	 cos_out6[] = dft_by_word6.cos_out[];
	 
	 --Permanent connectios of flipflop which increments step of all 6 DFT;
	 next_step_all_ff.clk = clk;
	 next_step_all_ff.clrn = !sreset;
	 
	 --Address selected of UFM is same for all 6 DFTs
	 dft_by_word1.next_step = next_step_all_ff.q;
	 dft_by_word2.next_step = next_step_all_ff.q;
	 dft_by_word3.next_step = next_step_all_ff.q;
	 dft_by_word4.next_step = next_step_all_ff.q;
	 dft_by_word5.next_step = next_step_all_ff.q;
	 dft_by_word6.next_step = next_step_all_ff.q;
	 
	 step_ufm_addr = dft_by_word6.luts_addr_out[];
	 --Clock of ff first_byte
	 first_byte.clk = clk;
	 --Inicial state of ff first_byte
	 first_byte.clrn = !sreset;
	 --Lock first_byte output into 1
	 first_byte.d = byte_counter_ff # first_byte;
	 --Lock first sample of channel 1
	 first_sample_ff.clk = clk;
	 first_sample_ff.clrn = !sreset;
	 first_sample_ff.d = first_byte # first_sample_ff;
	 
    --Clock of nop count
    count_nop[].clk = clk;
	 
	 --Clock of output register
	 out_reg_MSB[].clk = clk;
	 out_reg_LSB[].clk = clk;
	 sample_word[] = (out_reg_MSB[], out_reg_LSB[]); 
	 
	 --Inputs of state machine
	 sm.clk = clk;
	 sm.reset = sreset;
	 
	 --Inputs of bytes counter
	 byte_counter_ff = clk;
	 byte_counter_ff.clrn = !sreset;
	 --Avoid defineless state of byte_counter_ff
	 byte_counter_ff = byte_counter_ff;
	 
	 --Clock of edge_detector
	 detect_rising.clk = clk;
	 detect_rising.reset = sreset # enable_read;
	 detect_rising.current_read_pulse = new_byte;
	 
	 --Register to identify channel which is making dft step
	 channel_number[].d = channel_number[].q + 1;
	 
    case sm is
        when idle =>	
	     
	     if !first_sample_ff then	  
		      if enable_read then
		  	       sm = idle;
		      else
		          if !first_byte & !byte_counter_ff then
		              sm = nop;
			       elsif detect_rising.rising_edge then
				        sm = nop;
			       else
				        sm = idle;
				    end if;
				
		      end if;
			else
			        if enable_read then
		  	           sm = idle;
		           else
		              if !first_byte & !byte_counter_ff then
		                  sm = nop;
			           elsif detect_rising.rising_edge then
				            sm = nop;
			           else
				            sm = idle;
				        end if;
		           end if;	           		 
				 
			end if;
			
		  when nop =>
				
			   count_nop[].d = count_nop[].q+1;
			   count_nop[].clrn = Vcc;
            if count_nop[] == B"10" then
			       sm = load;
			   else
			       sm = nop;
			   end if;
			
		  when load =>

      		--First load
				if !first_byte then
				    byte_counter_ff.d = Vcc;
				    out_reg_LSB[].d = byte_channel[];
					 out_reg_LSB[].ena = Vcc;
			       sm = idle;
			   else
				    if byte_counter_ff == 1 then
					     byte_counter_ff.d = Gnd;
				        out_reg_MSB[].d = byte_channel[];
						  out_reg_MSB[].ena = Vcc;
						  
						  if channel_number[] == B"000" then
						      dft_by_word1.start_dft = Vcc;
						  elsif channel_number[] == B"001" then 
								dft_by_word2.start_dft = Vcc;
						  elsif channel_number[] == B"010" then 
								dft_by_word3.start_dft = Vcc;
						  elsif channel_number[] == B"011" then 
								dft_by_word4.start_dft = Vcc;
						  elsif channel_number[] == B"100" then 
								dft_by_word5.start_dft = Vcc;
						  elsif channel_number[] == B"101" then 
								dft_by_word6.start_dft = Vcc;
						  end if;
						  
			           sm = load_dft;
				    else
					     byte_counter_ff.d = Vcc; 
				        out_reg_LSB[].d = byte_channel[];
						  out_reg_LSB[].ena = Vcc;
			           sm = idle;
				    end if;
				end if;

		  when load_dft =>
		      
				sm = calculus_dft;
				
		  when calculus_dft =>
		      
				sm = sum_dft;
				
		  when sum_dft =>
		  
				if channel_number[] == B"000" then
					 dft_by_word1.next_sample = Vcc;
					 channel_number[].clk = Vcc;
				elsif channel_number[] == B"001" then 
					 dft_by_word2.next_sample = Vcc;
					 channel_number[].clk = Vcc;
				elsif channel_number[] == B"010" then 
					 dft_by_word3.next_sample = Vcc;
					 channel_number[].clk = Vcc;
				elsif channel_number[] == B"011" then 
					 dft_by_word4.next_sample = Vcc;
					 channel_number[].clk = Vcc;
				elsif channel_number[] == B"100" then 
					 dft_by_word5.next_sample = Vcc;
					 channel_number[].clk = Vcc;
				elsif channel_number[] == B"101" then 
					 dft_by_word6.next_sample = Vcc;
					 next_step_all_ff.d = Vcc;
					 channel_number[].clrn = Gnd;
				end if;
		  
				sm = idle;
					
    end case;
	
end;