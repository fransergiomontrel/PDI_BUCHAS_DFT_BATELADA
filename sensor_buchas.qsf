set_global_assignment -name AHDL_FILE adc_interface.tdf
set_global_assignment -name AHDL_FILE acquisition_store.tdf
set_global_assignment -name AHDL_FILE acquisition_serializer.tdf
set_global_assignment -name AHDL_FILE acquisition_module.tdf
set_global_assignment -name AHDL_FILE acquisition_ctrl.tdf
