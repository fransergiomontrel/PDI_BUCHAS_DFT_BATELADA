include "mode_selector.inc";

subdesign host_interface(
	clk: input;
	reset: input;
	running: input = Vcc;
	sdi[5..0]: input;

	host_mode[1..0]: input;
	host_start: input;
	host_convst: input;
	host_sclk: input;
	host_rst_n: input;
	
	mode[1..0]: output;
	changing_mode: output;
	start: output;
	convst: output;
	rst_n: output;
	host_running: output;
	host_ready: output;
	host_sdi[5..0]: output;
)
variable
	mode_sel: mode_selector;
	start_ff: dff;
begin
	-- Mode selector
	mode_sel.clk = clk;
	mode_sel.reset = reset;
	mode_sel.mode_in[] = host_mode[];
	mode[] = mode_sel.mode_out[];
	host_running = running;
	host_ready = mode_sel.ready;
	changing_mode = mode_sel.changing;
	mode_sel.change_ok = Vcc;		-- TODO: ainda não há um critério para evitar a mudança de estado

	-- start
	start_ff.clk = clk;
	start_ff.d = host_start;
	start = start_ff.q;
	
	host_sdi[] = sdi[];
end;