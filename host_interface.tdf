include "mode_selector.inc";

subdesign host_interface(
	clk: input;
	sreset: input;
	busy: input = Vcc;
	MISO: input;

	host_mode[1..0]: input;
	host_convst_start: input;
	host_rst_n: input;

	host_SCLK: input;
	host_MOSI: input;
	
	ready_mode0: input;
	ready_mode1: input;
	ready_mode2: input;
	ready_mode3: input;
	
	mode[1..0]: output;
	changing_mode: output;
	convst_start: output;
	rst_n: output;
	SCLK_: output;
	MOSI: output;
		
	sreset_mode0: output;
	sreset_mode1: output;
	sreset_mode2: output;
	sreset_mode3: output;
	
	host_busy: output;
	host_MISO: output;
)
variable
	
	mode_sel: mode_selector;
	busy_flag: srff;
	rm0, rm1, rm2, rm3: node;
begin
	-- Mode selector
	
	
	mode_sel.clk = clk;
	mode_sel.sreset = sreset;
	mode_sel.mode_in[] = host_mode[];
	mode[] = mode_sel.mode_out[];
	changing_mode = mode_sel.changing;
	mode_sel.change_ok = Vcc;		-- TODO: ainda não há um critério para evitar a mudança de estado
	
	convst_start = host_convst_start;
	rst_n = host_rst_n;
	
	SCLK_ = host_SCLK;
	MOSI = host_MOSI;
	host_MISO = MISO;

	sreset_mode0 = sreset or mode_sel.changing or (mode_sel.mode_out[]!=0);
	sreset_mode1 = sreset or mode_sel.changing or (mode_sel.mode_out[]!=1);
	sreset_mode2 = sreset or mode_sel.changing or (mode_sel.mode_out[]!=2);
	sreset_mode3 = sreset or mode_sel.changing or (mode_sel.mode_out[]!=3);
	
	-- BUSY FLAG
	busy_flag.clk = clk;
	busy_flag.prn = !(sreset or mode_sel.changing);
	busy_flag.s = Gnd;
	case mode_sel.mode_out[] is
		when 0 =>
			busy_flag.r = ready_mode0;
		when 1 =>
			busy_flag.r = ready_mode1;
		when 2 =>
			busy_flag.r = ready_mode2;
		when 3 =>
			busy_flag.r = ready_mode3;
	end case;
	host_busy = busy_flag.q or busy;
	
end;