include "lpm_counter.inc";

parameters(
	MAX_VALUE = 12
);

constant N_BITS = log2(MAX_VALUE+1);

subdesign teste(
	clk: input;
	reset: input = Gnd;
	clr: input = Gnd;
	inc: input = Gnd;
	
	o[N_BITS-1..0]: output
)
variable
	cont: lpm_counter with(LPM_DIRECTION="UP", LPM_MODULUS=MAX_VALUE+1, LPM_WIDTH = N_BITS);
begin
	cont.clock = clk;
	cont.aclr = reset;
	cont.sclr = clr;
	cont.cnt_en = inc;
	o[] = cont.q[];
end;