--Este módulo gera contagem em sequencia diferente dependendo de SEED.
--É útil para testar módulos que precisam de valores distintos de entrada.

parameters(
	SEED = 7,
	N_BITS = 3
);

constant NUM_BITS_PAR = N_BITS + (((N_BITS MOD 2) == 0)? 0 : 1);
constant METADE_BITS = NUM_BITS_PAR DIV 2;

subdesign generate_values(
	sreset: input;
	clk: input;
	inc: input;
	
	o[N_BITS-1..0]: output; 
)
variable
	cont[NUM_BITS_PAR-1..0]: dffe;
	step1[NUM_BITS_PAR-1..0]: node;
	step2[NUM_BITS_PAR-1..0]: node;
begin
	cont[].clk = clk;
	cont[].ena = inc;
	if sreset then
		cont[].d = 0;
	else
		cont[].d = cont[].q+1;
	end if;
	
	if SEED MOD 2 == 1 generate
		step1[] = cont[].q;
	else generate
		step1[] = !cont[].q;
	end generate;

	if (SEED DIV 2) MOD 2 == 1 generate
		step2[] = step1[];
	else generate
		step2[] = (step1[METADE_BITS-1..0],step1[NUM_BITS_PAR-1..METADE_BITS]);
	end generate;
	
	if (SEED DIV 4) MOD 2 == 1 generate
		o[] = step2[N_BITS-1..0];
	else generate
		o[] = step2[0..N_BITS-1];
	end generate;
	
end;