include "modes.inc";
include "synchronizer.inc";

subdesign main_sm
(
	clk: INPUT;				-- Clock principal
	mode_in[1..0]: input;
	reset: input;
	busy: input;
	
	mode_out[1..0]: output;
	ready: output;
	changing: output;
)
variable
	sm : MACHINE WITH STATES (sRst, sWait_Busy, sWait_mode_changed, sNone, sConfiguration, sAquisition, sReadData);
	sync: synchronizer with (bus_size = 2);
	mode_s[1..0]: node;
	changing_ff, ready_ff: dff;
	mode_out_ff[1..0]: dffe;
begin
	defaults
		changing_ff.d = Vcc;
		ready_ff = Gnd;
		mode_out_ff[].ena = Gnd;
	end defaults;

	sm.clk = clk;
	sm.reset = reset;
	
	sync.clk = clk;
	sync.i[] = mode_in[];
	mode_s[] = sync.o[];
	
	ready_ff.clk = clk;
	ready_ff.clrn = !reset;
	ready = ready_ff;
	
	changing_ff.clk = clk;
	changing_ff.prn = !reset;
	changing = changing_ff;
	
	mode_out_ff[].clk = clk;
	mode_out_ff[] = mode_s[];
	mode_out[] = mode_out_ff[];

	case sm is
		when sRst =>
			sm = sWait_mode_changed;
			
		when sWait_Busy =>
			if busy then
				changing_ff.d = Gnd;
			else
				sm = sWait_mode_changed;
			end if;

		when sWait_mode_changed =>
			mode_out_ff[].ena = Vcc;
			case mode_s[] is
				when mode_NONE =>
					sm = sNone;
				when mode_CONFIGURATION =>
					sm = sConfiguration;
				when mode_AQUISITION =>
					sm = sAquisition;
				when mode_READ_DATA =>
					sm = sReadData;
			end case;
			
		when sNone =>
			if mode_s[] == mode_NONE then
				ready_ff = sync.stable;
				changing_ff.d = Gnd;
				sync.enable = Vcc;		-- Só permite alterar o valor da entrada mode se já estiver estável em um modo (durante a alteração a entrada mode é ignorada)
			else
				if busy then
					changing_ff.d = Gnd;
					sm = sWait_Busy;
				else
					sm = sWait_mode_changed;
				end if;
			end if;
			
		when sConfiguration =>
			if mode_s[] == mode_CONFIGURATION then
				ready_ff = sync.stable;
				changing_ff.d = Gnd;
				sync.enable = Vcc;		-- Só permite alterar o valor da entrada mode se já estiver estável em um modo (durante a alteração a entrada mode é ignorada)
			else
				if busy then
					changing_ff.d = Gnd;
					sm = sWait_Busy;
				else
					sm = sWait_mode_changed;
				end if;
			end if;
			
		when sAquisition =>
			if mode_s[] == mode_AQUISITION then
				ready_ff = sync.stable;
				changing_ff.d = Gnd;
				sync.enable = Vcc;		-- Só permite alterar o valor da entrada mode se já estiver estável em um modo (durante a alteração a entrada mode é ignorada)
			else
				if busy then
					changing_ff.d = Gnd;
					sm = sWait_Busy;
				else
					sm = sWait_mode_changed;
				end if;
			end if;
			
		when sReadData =>
			if mode_s[] == MODE_READ_DATA then
				ready_ff = sync.stable;
				changing_ff.d = Gnd;
				sync.enable = Vcc;		-- Só permite alterar o valor da entrada mode se já estiver estável em um modo (durante a alteração a entrada mode é ignorada)
			else
				if busy then
					changing_ff.d = Gnd;
					sm = sWait_Busy;
				else
					sm = sWait_mode_changed;
				end if;
			end if;
	end case;
end;

