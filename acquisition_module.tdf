include "acquisition_ctrl_v2.inc";
include "acquisition_serializer_v3.inc";
include "acquisition_store.inc";
--include "acquisition_store_crc.inc";
include "acquisition_store_time_counter.inc";
include "dffes.inc";
--include "crc16.inc";
include "acquisition_time_counter.inc";

parameters(
	samples = 3
);

subdesign acquisition_module(
	clk: input;
	sreset: input;
	start: input;
	sdi[5..0]: input;
	
	frequency: input;

	sclk_: output;	
	convst: output;
	addr_inc_write: output;
	addr_clr: output;
	busy: output;
	we_n: output;
	cs_n: output;
	data[15..0]: output;
	data_bus_out: output;
	
	ready: output;
	
--	test_crc16[15..0]: output;

)
variable
	start_ff: dffes;
--	ctrl: acquisition_ctrl_v2 with (active_period = 68, period = 463, samples = samples);
	ctrl: acquisition_ctrl_v2 with (active_period = 68, samples = samples);
	serializer: acquisition_serializer_v3 with (little_endian = 0, wait_states = 3);
	storer: acquisition_store;
	--storer_crc: acquisition_store_crc;
	--crc: crc16;
	atc: acquisition_time_counter;
	storer_time_counter: acquisition_store_time_counter;

begin
	
	-- ACQUISITION_TIME_COUNTER
	atc.clk = clk;
	atc.sreset = sreset;
	atc.restart = ctrl.time_counter_restart;
	atc.byte_number[] = storer_time_counter.channel[];
	
	-- START
	start_ff.d = start;
	start_ff.clk = clk;
	start_ff.sclr = sreset;

	-- CTRL
	ctrl.clk = clk;
	ctrl.sreset = sreset;
	ctrl.start = start_ff.q;
	ctrl.serialize_ok = serializer.serialize_ok;
	ctrl.store_ok = storer.store_ok;
	ctrl.frequency = frequency;

	-- SERIALIZER
	serializer.clk = clk;
	serializer.sreset = sreset;
	serializer.serialize = ctrl.serialize;
	serializer.msb = Gnd;--storer.msb;
	serializer.channel[] = storer.channel[];
	serializer.adc_sdi[] = sdi[];

	-- STORE
	storer.clk = clk;
	storer.sreset = sreset;
	storer.store = ctrl.store;
	
	-- CRC16
	--crc.clk = clk;
	--crc.rst = ctrl.crc_clr;
	--crc.crc_en = storer.crc_enable or storer_time_counter.crc_enable;
--	test_crc16[] = crc.crc_out[];
	--crc.msb = storer_crc.msb;

	-- STORE_CRC
	--storer_crc.clk = clk;
	--storer_crc.sreset = sreset;
	--storer_crc.store_crc = ctrl.store_crc;
	--ctrl.store_crc_ok = storer_crc.store_crc_ok;
	
	-- STORE_TIME_COUNTER
	storer_time_counter.clk = clk;
	storer_time_counter.sreset = sreset;
	storer_time_counter.store_time_counter = ctrl.store_time_counter;
	ctrl.store_time_counter_ok = storer_time_counter.store_time_counter_ok;
	
	-- READY
	ready = ctrl.ready;
	
	-- OUTPUTS	
	convst = ctrl.convst;
	addr_clr = ctrl.addr_clr;
	busy = ctrl.busy;
	sclk_ = serializer.adc_sclk;
	--cs_n = storer.cs_n and storer_crc.cs_n and storer_time_counter.cs_n;
	--we_n = storer.we_n and storer_crc.we_n and storer_time_counter.we_n;
	cs_n = storer.cs_n and storer_time_counter.cs_n;
	we_n = storer.we_n and storer_time_counter.we_n;
	--addr_inc_write = storer.addr_inc_write or storer_crc.addr_inc_write or storer_time_counter.addr_inc_write;
	--data_bus_out = storer.data_bus_out or storer_crc.data_bus_out or storer_time_counter.data_bus_out;
	addr_inc_write = storer.addr_inc_write or storer_time_counter.addr_inc_write;
	data_bus_out = storer.data_bus_out or storer_time_counter.data_bus_out;
		
	data[] = serializer.data[];
	
end;
