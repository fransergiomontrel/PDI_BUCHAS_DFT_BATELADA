include "acquisition_ctrl.inc";
include "acquisition_serializer.inc";
include "acquisition_store.inc";
include "modes.inc";

parameters(
	samples = 3
);


subdesign acquisition_module(
	clk: input;
	reset: input;
	start: input;
	mode[1..0]: input;
	sdi[5..0]: input;
	changing_mode: input;
	

	sclk_: output;	
	convst: output;
	addr_inc: output;
	addr_clr: output;
	running: output;
	we_n: output;
	cs_n: output;
	data[7..0]: output;
)
variable
	start_ff: dffe;
	ctrl: acquisition_ctrl with (active_period = 68, period = 463, samples = samples);
	serializer: acquisition_serializer with (little_endian = 1);
	storer: acquisition_store;
begin
	-- START
	start_ff.d = start;
	start_ff.clk = clk;
	start_ff.ena = !changing_mode and mode[] == MODE_AQUISITION;

	-- CTRL
	ctrl.clk = clk;
	ctrl.reset = reset;
	ctrl.start = start_ff.q;
	ctrl.serialize_ok = serializer.serialize_ok;
	ctrl.store_ok = storer.store_ok;

	-- SERIALIZER
	serializer.clk = clk;
	serializer.reset = reset;
	serializer.serialize = ctrl.serialize;
	serializer.msb = storer.msb;
	serializer.channel[] = storer.channel[];
	serializer.adc_sdi[] = sdi[];
	
	-- STORE
	storer.clk = clk;
	storer.reset = reset;
	storer.store = ctrl.store;
		
	-- OUTPUTS	
	convst = ctrl.convst;
	addr_clr = ctrl.addr_clr;
	running = ctrl.running;
	sclk_ = serializer.adc_sclk;
	cs_n = storer.cs_n;
	we_n = storer.we_n;
	addr_inc = storer.addr_inc;
	data[] = serializer.data[];
end;

