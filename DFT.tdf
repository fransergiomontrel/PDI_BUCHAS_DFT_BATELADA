include "produto_modulo.inc";

subdesign DFT(
           
	 clk: input;
	 reset: input;
	 read_sample[15..0]: input;	 
	 start_dft: input;
	 end_tx: input;
	 luts_dft_in[31..0]: input;
	 sample_counter[12..0]: input;
	 
	 sin_out[31..0]: output;
	 cos_out[31..0]: output;
	 
	 start_tx: output;
	 
	 	 
)

variable
sm: machine with states(idle, product, product1, sum, check_end, await_end_tx);

start_tx_ff: dff;

multiplier_dft_sin, multiplier_dft_cos : produto_modulo;

acc_sin[31..0], acc_cos[31..0]: dffe;


begin

    defaults
		  
		  multiplier_dft_sin.product_on = Gnd;
		  multiplier_dft_cos.product_on = Gnd;
		  
		  acc_sin[].clrn = Vcc;
		  acc_cos[].clrn = Vcc;
		  
		  acc_sin[].ena = Gnd;
		  acc_cos[].ena = Gnd;
		  
		  start_tx_ff.d = Gnd;
		  
		
	 end defaults;
	 
	 
	 --Inputs of state machine
	 sm.clk = clk;
	 sm.reset = reset;
	 
	 --Permanent connections of start_tx_ff
	 start_tx_ff.clk = clk;
	 start_tx_ff.clrn = !reset;
	 start_tx = start_tx_ff.q;
	 
	 --Permanent connections of multipliers for sin and cos
	 multiplier_dft_sin.clk = clk;
	 multiplier_dft_cos.clk = clk;
	 
	 multiplier_dft_sin.reset = reset;
	 multiplier_dft_cos.reset = reset;
	 
	 multiplier_dft_sin.data[] = read_sample[];
	 multiplier_dft_cos.data[] = read_sample[];
	 
	 --Value of luts table assigned to multiplier unit
	 multiplier_dft_sin.luts[] = luts_dft_in[31..16];
	 multiplier_dft_cos.luts[] = luts_dft_in[15..0];
	 
	 --Acumulators
	 acc_sin[].clk = clk;
	 acc_cos[].clk = clk;
	 
	 
	 --Appling 2 complement in negative regions of sine
	 if sample_counter[] <= 3607 then
	     acc_sin[].d = acc_sin[].q + multiplier_dft_sin.dft_component[];
	 else
	     acc_sin[].d = acc_sin[].q - multiplier_dft_sin.dft_component[];
	 end if;
	 
	 --Appling 2 complement in negative regions of cossine
	 if sample_counter[] <= 1803 # sample_counter[] >= 5411 then
	     acc_cos[].d = acc_cos[].q + multiplier_dft_cos.dft_component[];
	 else 
	     acc_cos[].d = acc_cos[].q - multiplier_dft_cos.dft_component[];
	 end if;
	 
    sin_out[] = acc_sin[];
	 cos_out[] = acc_cos[];
   	 
	 case sm is
        when idle =>
		  
		  if !start_dft then
		      
		  	   sm = idle;
		  else
		      
				multiplier_dft_sin.product_on = Vcc;
		      multiplier_dft_cos.product_on = Vcc;
				sm = product;
		  end if;
			
		  when product =>
		  	      
				sm = product1;
				
			when product1 =>
		  	      
				sm = sum;
				
        when sum =>
		  	   acc_sin[].ena = Vcc;
	         acc_cos[].ena = Vcc;   
				sm = check_end;
				
        when check_end =>
		  	     
				if sample_counter[] == 7214 then
				    
					 sm = await_end_tx;
					 
			   else
				    sm = idle;
			   end if;
		      			 
					 		 
		 when await_end_tx =>
		  	   if end_tx then
				    acc_sin[].clrn = Gnd;
		          acc_cos[].clrn = Gnd;
				    sm = idle;	
		      else
				    sm = await_end_tx;
					 start_tx_ff.d = Vcc;
					 
			   end if;
		  
	 end case;

end;