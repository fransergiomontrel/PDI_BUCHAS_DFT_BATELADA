<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=verilog --output_directory="C:/SensorBuchasV2/TEST_MODE_CONFIGURATION/simulation/qsim/" test_mode_configuration -c test_mode_configuration</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="C:/SensorBuchasV2/TEST_MODE_CONFIGURATION/simulation/qsim/" test_mode_configuration -c test_mode_configuration</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vlog -work work test_mode_configuration.vo
vlog -work work test_mode_configuration.vwf.vt
vsim -c -t 1ps -L maxii_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.test_mode_configuration_vlg_vec_tst
