`timescale 1 ps/ 1 ps
module test_mode_configuration_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg rst;
// wires                                               
wire adc_convst;
wire adc_rst_n;
wire adc_sclk;
wire [5:0] adc_sdo;
wire host_MISO;
wire test_probe;

// assign statements (if any)                          
test_mode_configuration i1 (
// port map - connection between master ports and signals/registers   
	.adc_convst(adc_convst),
	.adc_rst_n(adc_rst_n),
	.adc_sclk(adc_sclk),
	.adc_sdo(adc_sdo),
	.clk(clk),
	.host_MISO(host_MISO),
	.rst(rst),
	.test_probe(test_probe)
);
initial 
begin 
#10000000 $finish;
end 

// rst
initial
begin
	rst = 1'b1;
	rst = #40000 1'b0;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 
endmodule

