include "counter.inc";

subdesign acquisition_store(
	clk: input;
	reset: input;
	store: input;
	
	we_n: output;
	cs_n: output;
	channel[2..0]: output;
	addr_inc: output;
	store_ok: output;
	msb: output;
	
	test_sm[2..0]: output;
)
variable	
	we_n_ff, cs_n_ff: dff;
	
	channel_counter: counter with (MAX_VALUE = 12);
	
	sm: MACHINE WITH STATES(WAIT_STORE, CS1a, CS0a, CS0b, CS1b, INC_CHANNEL, WAIT_END);
begin
	defaults
		we_n_ff = Gnd;
		cs_n_ff = Vcc;
		addr_inc = Gnd;
		store_ok = Gnd;

		channel_counter.inc = Gnd;
		channel_counter.clr = Gnd;
	end defaults;
	
	-- resets
	channel_counter.reset = reset;
	sm.reset = reset;
	we_n_ff.prn = !reset;
	cs_n_ff.prn = !reset;
	
	-- Sync data
	we_n_ff.clk = clk;
	cs_n_ff.clk = clk;
	channel_counter.clk = clk;
	sm.clk = clk;

	case sm IS
		WHEN WAIT_STORE =>
test_sm[] = 0;
			if store then
				sm = CS1a;
			else
				we_n_ff = Vcc;
				channel_counter.clr = Vcc;
				sm = WAIT_STORE;
			end if;
			
		WHEN CS1a =>
test_sm[] = 1;
			cs_n_ff = Gnd;
			sm = CS0a;
			
		WHEN CS0a =>
test_sm[] = 2;
			cs_n_ff = Gnd;
			sm = CS0b;

		WHEN CS0b =>
test_sm[] = 3;
			sm = CS1b;
			
		WHEN CS1b =>
test_sm[] = 4;
			channel_counter.inc = Vcc;
			addr_inc = Vcc;
			sm = INC_CHANNEL;
		
		WHEN INC_CHANNEL =>
test_sm[] = 5;
			if channel_counter.o[] == 12 then
				we_n_ff = Vcc;
				store_ok = Vcc;
				sm = WAIT_END;				
			else
				sm = CS1a;
			
			end if;
		WHEN WAIT_END =>
test_sm[] = 6;
			if store then
				we_n_ff = Vcc;
				store_ok = Vcc;
			else
				we_n_ff = Vcc;
				channel_counter.clr = Vcc;
				sm = WAIT_STORE;
				
			end if;
	END CASE;

	-- Sync outs
	we_n = we_n_ff;
	cs_n = cs_n_ff;
	channel[] = channel_counter.o[3..1];
	msb = channel_counter.o[0];
end;