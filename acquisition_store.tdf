include "counter.inc";
include "dffes.inc";

subdesign acquisition_store(
	clk: input;
	sreset: input;
	store: input;
	
	we_n: output;
	cs_n: output;
	channel[2..0]: output;
	addr_inc_write: output;
	store_ok: output;
	
	data_bus_out: output;
	
)
variable	
	--cs_n_ff, we_n_ff, data_bus_out_ff, crc_enable_ff: dffes;
	cs_n_ff, we_n_ff, data_bus_out_ff: dffes;
	channel_counter: counter with (MAX_VALUE = 6);
	last_channel: node;
	
	sm: MACHINE WITH STATES(WAIT_STORE, CS1a,	CS0a1, CS0a2, CS0b, CS1b ,	INC_CHANNEL, WAIT_END);
begin
	defaults
		cs_n_ff.d = Gnd;
		we_n_ff.d = Vcc;
		data_bus_out_ff.d = Gnd;
		addr_inc_write = Gnd;
		store_ok = Gnd;

		channel_counter.inc = Gnd;
		channel_counter.clr = Gnd;
		
	end defaults;
	
	-- sresets
	channel_counter.sreset = sreset;
	sm.reset = sreset;
	cs_n_ff.spre = sreset;
	we_n_ff.spre = sreset;
	data_bus_out_ff.sclr = sreset;
	
	-- Sync data
	cs_n_ff.clk = clk;
	we_n_ff.clk = clk;
	data_bus_out_ff.clk = clk;
	
	channel_counter.clk = clk;
	sm.clk = clk;
	
	last_channel = (channel_counter.o[] == 6);

	case sm IS
		WHEN WAIT_STORE =>

			if store then
				data_bus_out_ff.d = Vcc;
				sm = CS1a;
			else
				cs_n_ff.d = Vcc;
				channel_counter.clr = Vcc;
				sm = WAIT_STORE;
			end if;
			
		WHEN CS1a =>

			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			sm = CS0a1;
			
		WHEN CS0a1 =>

			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			sm = CS0a2;

		WHEN CS0a2 =>

			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			
			sm = CS0b;

			WHEN CS0b =>

			data_bus_out_ff.d = Vcc;
			sm = CS1b;
			
		WHEN CS1b =>

			channel_counter.inc = Vcc;
			addr_inc_write = Vcc;
			sm = INC_CHANNEL;
		
		WHEN INC_CHANNEL =>

			if last_channel then
				cs_n_ff.d = Vcc;
				store_ok = Vcc;
				sm = WAIT_END;				
			else
				data_bus_out_ff.d = Vcc;
				sm = CS1a;
			
			end if;
		WHEN WAIT_END =>

			if store then
				cs_n_ff.d = Vcc;
				store_ok = Vcc;
			else
				cs_n_ff.d = Vcc;
				channel_counter.clr = Vcc;
				sm = WAIT_STORE;
				
			end if;
	END CASE;

	-- Sync outs
	cs_n = cs_n_ff.q;
	we_n = we_n_ff.q;
	data_bus_out = data_bus_out_ff.q;
	channel[] = channel_counter.o[2..0];
	
end;