set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "NO HEAT SINK WITH STILL AIR"
set_global_assignment -name AHDL_FILE test_RAM.tdf
set_global_assignment -name VECTOR_WAVEFORM_FILE Waveform.vwf
