include "RAM_interface.inc";
include "modes.inc";
PARAMETERS
(
		N_BITS = 19
);

subdesign test_RAM(
	clk: input;
	reset: input;
	
	ram_address[N_BITS-1..0]: output;
	ram_data_bus[7..0]: bidir;
	
	ram_we_n: output;
	ram_cs_n: output;
	ram_oe_n: output;
	
	data_out[7..0]: output;
	
	test_state[13..0]: output;

	
	we_n: output;
	oe_n: output;
	cs_n: output;
	
	test_mode[1..0]: output;
)
variable
	ri: RAM_interface with (N_BITS = 19);
	sm: machine of bits (test_state[13..0]) with states (
		e0 = b"00000000000001",
		e1 = b"00000000000010",
		e2 = b"00000000000100",
		e3 = b"00000000001000",
		e3a= b"00000000010000",
		e3b= b"00000000100000",
		e3c= b"00000001000000",
		e4 = b"00000010000000",
		e5 = b"00000100000000",
		e6 = b"00001000000000",
		e6a= b"00010000000000",
		e6b= b"00100000000000",
		e6c= b"01000000000000",
		e7 = b"10000000000000");
	ff_out[7..0]: dffe;
	sreset: node;
	ff_rst, ff_oe, ff_we, ff_mode[1..0]: dff;
begin
	defaults
		ri.addr_clr = Gnd;
		ri.addr_inc = Gnd;
		ff_out[].ena = Gnd;
		
		ff_oe.d = Vcc;
		ff_we.d = Vcc;
	end defaults;
	
	we_n = ram_we_n;
	oe_n = ram_oe_n;
	cs_n = ram_cs_n;
	
	sm.clk = clk;
	sm.reset = sreset;

	ff_rst.clk = clk;
	ff_rst.d = reset;
	sreset = ff_rst.q;
	
	ff_out[].clk = clk;
	ff_out[].d = ri.data_out[];
	data_out[] = ff_out[].q;
--	data_out[] = ri.ram_address[7..0];
--	data_out[] = ram_data_bus[7..0];
	ff_out[].clrn = !sreset;

	ri.clk = clk;
	ri.sreset = sreset;
	ram_address[] = ri.ram_address[];
	ram_we_n = ri.ram_we_n;
	ram_cs_n = ri.ram_cs_n;
	ram_oe_n = ri.ram_oe_n;
	ri.changing_mode = Gnd;
	ri.data_in[7..0] = !ri.ram_address[7..0];
	ram_data_bus[] = ri.ram_data_bus[];
	ri.cs_n = Gnd;
	
	ff_oe.clk = clk;
	ff_oe.prn = !reset;
	ri.oe_n = ff_oe.q;
	
	ff_we.clk = clk;
	ff_we.prn = !reset;
	ri.we_n = ff_we.q;
	
	ff_mode[].clk = clk;
	ri.mode[] = ff_mode[].q;
	test_mode[] = ff_mode[].q;

	case sm is
		when e0 =>
			ff_mode[].d = MODE_AQUISITION;
			ri.addr_clr = Vcc;
			sm = e2;

		when e1 =>
			if ri.ram_address[] == H"0F" then
				ri.addr_clr = Vcc;
			else
				ri.addr_inc = Vcc;
			end if;
			ff_mode[].d = MODE_AQUISITION;
			sm = e2;

		when e2 =>
			ff_we.d = Gnd;
			ff_mode[].d = MODE_AQUISITION;
			sm = e3;

		when e3 =>
			ff_we.d = Gnd;
			ff_mode[].d = MODE_AQUISITION;
			sm = e3a;

		when e3a =>
			ff_we.d = Gnd;
			ff_mode[].d = MODE_AQUISITION;
			sm = e3b;

		when e3b =>
			ff_we.d = Gnd;
			ff_mode[].d = MODE_AQUISITION;
			sm = e3c;

		when e3c =>
			if ri.ram_address[] == H"0F" then
				sm = e4;
--				ff_oe.d = Gnd;
			else
				sm = e1;
			end if;
			ff_mode[].d = MODE_AQUISITION;

		when e4 =>
			if ri.ram_address[] == H"0F" then
				ri.addr_clr = Vcc;
			else
				ri.addr_inc = Vcc;
			end if;
			ff_mode[].d = MODE_READ_DATA;
--			ff_oe.d = Gnd;
			sm = e5;

		when e5 =>
			ff_oe.d = Gnd;
			ff_mode[].d = MODE_READ_DATA;
			sm = e6;

		when e6 =>
			ff_oe.d = Gnd;
			ff_mode[].d = MODE_READ_DATA;
			sm = e6a;

		when e6a =>
			ff_oe.d = Gnd;
			ff_mode[].d = MODE_READ_DATA;
			sm = e6b;

		when e6b =>
			ff_oe.d = Gnd;
			ff_mode[].d = MODE_READ_DATA;
			sm = e6c;

		when e6c =>
			ff_oe.d = Gnd;
			ff_mode[].d = MODE_READ_DATA;
			sm = e7;

		when e7 =>
			ri.mode[] = MODE_READ_DATA;
			if ri.ram_address[] == H"0F" then
				sm = e1;
			else
--				ff_oe.d = Gnd;
				sm = e4;
			end if;
			ff_mode[].d = MODE_READ_DATA;
	end case;
	ff_out[].ena = test_state[13];
end;



