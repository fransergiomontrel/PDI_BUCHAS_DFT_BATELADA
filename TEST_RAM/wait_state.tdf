include "counter.inc";

subdesign wait_state(
	clk: input;
	value[3..0]: input;
	set: input;
	
	waiting: output;
)
variable
	c[3..0]: dffe;
	non_zero: node;
begin
	c[].clk = clk;
	non_zero = (c[3].q or c[2].q or c[1].q or c[0].q);
	c[].ena = non_zero or set;
	waiting = non_zero;
	
	if set then
		c[].d = value[];
	else
		c[].d = c[].q-1;
	end if;
end;