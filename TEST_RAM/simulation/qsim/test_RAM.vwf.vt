end 
// ram_data_bus[ 3 ]
initial
begin
	treg_ram_data_bus[3] = 1'bZ;
end 
// ram_data_bus[ 2 ]
initial
begin
	treg_ram_data_bus[2] = 1'bZ;
end 
// ram_data_bus[ 1 ]
initial
begin
	treg_ram_data_bus[1] = 1'bZ;
end 
// ram_data_bus[ 0 ]
initial
