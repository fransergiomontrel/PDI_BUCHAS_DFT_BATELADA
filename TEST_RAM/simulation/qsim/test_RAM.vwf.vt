`timescale 1 ps/ 1 ps
module test_RAM_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg [7:0] treg_ram_data_bus;
reg sreset;
// wires                                               
wire [7:0] data_out;
wire [18:0] ram_address;
wire ram_cs_n;
wire [7:0] ram_data_bus;
wire ram_oe_n;
wire ram_we_n;

// assign statements (if any)                          
assign ram_data_bus = treg_ram_data_bus;
test_RAM i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.data_out(data_out),
	.ram_address(ram_address),
	.ram_cs_n(ram_cs_n),
	.ram_data_bus(ram_data_bus),
	.ram_oe_n(ram_oe_n),
	.ram_we_n(ram_we_n),
	.sreset(sreset)
);
initial 
begin 
#1000000 $finish;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// sreset
initial
begin
	sreset = 1'b1;
	sreset = #10000 1'b0;
end 
// ram_data_bus[ 7 ]
initial
begin
	treg_ram_data_bus[7] = 1'bZ;
end 
// ram_data_bus[ 6 ]
initial
begin
	treg_ram_data_bus[6] = 1'bZ;
end 
// ram_data_bus[ 5 ]
