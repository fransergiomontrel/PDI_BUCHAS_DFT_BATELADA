`timescale 1 ps/ 1 ps
module wait_clocks_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg start;
// wires                                               
wire waiting;

// assign statements (if any)                          
wait_clocks i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.start(start),
	.waiting(waiting)
);
initial 
begin 
#1000000 $finish;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// start
initial
begin
	start = 1'b0;
	start = #40000 1'b1;
	start = #50000 1'b0;
end 
endmodule

