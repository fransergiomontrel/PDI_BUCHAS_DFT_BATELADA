

PARAMETERS
(
		MAX_VALUE = 7
);

constant N_BITS = log2(MAX_VALUE+1);

ASSERT (1==2)
	REPORT		"Valor maximo = (%) Numero de bits = (%)" MAX_VALUE, N_BITS
	SEVERITY	INFO;

subdesign counter(
	clk: input;
	sreset: input = Gnd;
	clr: input = Gnd;
	inc: input = Gnd;
	
	o[N_BITS-1..0]: output
)
variable
	ffs[N_BITS-1..0]: dff;
begin
	ffs[].clk = clk;
	if clr or sreset then
		ffs[] = 0;
	else
		if inc then
			if ffs[] == MAX_VALUE then
				ffs[] = 0;
			else
				ffs[] = ffs[] + 1;
			end if;
		else
			ffs[] = ffs[];
		end if;
	end if;
	o[] = ffs[];
end;
