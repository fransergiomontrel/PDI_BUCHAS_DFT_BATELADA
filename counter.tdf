PARAMETERS
(
		MAX_VALUE = 7
);

constant N_BITS = log2(MAX_VALUE+1);

subdesign counter(
	clk: input;
	reset: input;
	clr: input;
	inc: input;
	
	o[N_BITS-1..0]: output
)
variable
	ffs[N_BITS-1..0]: dff;
begin
	ffs[].clk = clk;
	ffs[].clrn = !reset;
	if clr then
		ffs[] = 0;
	else
		if inc then
			if ffs[] == MAX_VALUE then
				ffs[] = 0;
			else
				ffs[] = ffs[] + 1;
			end if;
		else
			ffs[] = ffs[];
		end if;
	end if;
	o[] = ffs[];
end;