parameters(
	N_BITS = 8
)

subdesign spi_shift(
	clk: input;
	async_load: input;
	parallel_in[N_BITS-1..0]: input;
	serial_in: input;
	parallel_out[N_BITS-1..0]: output;
	serial_out: output;
	
	loading: output;
	
--	test_shift[N_BITS-1..0]: output;
)
variable
	data_shift[N_BITS-1..0], control_shift[N_BITS-1..0], init_control: dffeas;
	parallel_ffs[N_BITS-1..0]: dffe;
begin
	data_shift[].clrn = !(async_load and !parallel_in[]);
	data_shift[].prn  = !(async_load and  parallel_in[]);
	
	control_shift[N_BITS-1..0].clrn = !async_load;
	init_control.prn = !async_load;
	control_shift[N_BITS-1..2].d = control_shift[N_BITS-2..1].q;
	control_shift[1].d = control_shift[0].q or init_control.q;
	control_shift[0].d = control_shift[N_BITS-1].q;
	init_control.d = Gnd;

	data_shift[N_BITS-1..1].d = data_shift[N_BITS-2..0].q;
	data_shift[0].d = serial_in;
	
	data_shift[].asdata = parallel_in[];
	data_shift[].sload = control_shift[7];

	control_shift[].clk = !clk;
	init_control.clk = !clk;
	data_shift[].clk = !clk;
	
	serial_out = data_shift[7].q;
	
	loading = control_shift[7];
	
	parallel_ffs[].clk = clk;
	parallel_ffs[].ena = control_shift[N_BITS-1];
	parallel_ffs[N_BITS-1..1].d = data_shift[N_BITS-2..0].q;
	parallel_ffs[0].d = serial_in;
	
	parallel_out[] = parallel_ffs[].q;
	
--	test_shift[] = control_shift[];
	
end;