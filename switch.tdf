include "modes.inc";

subdesign switch(
	clk: input;
	sreset: input;
	
	-- Host Interface
	HI_mode[1..0]: input;
	HI_changing_mode: input;
	HI_convst_start: input;
	HI_rst_n: input;
	HI_busy: output;
	HI_SCLK: input;
	HI_MOSI: input;
	HI_MISO: output;
	
	-- RAM Interface
	RI_data_out[7..0]: input;
	RI_addr_clr: output;
	RI_addr_inc: output;
	RI_data_in[7..0]: output;
	RI_we_n: output;
	RI_oe_n: output;
	RI_cs_n: output;
	RI_mode[1..0]: output;
	RI_changing_mode: output;
	RI_data_bus_out: output;
	
	-- ADC Interface
	AI_sdi[5..0]: input;
	AI_changing_mode: output;
	AI_rst_n: output;
	AI_convst: output;
	AI_sclk: output;
	AI_sdo[5..0]: output;
	
	-- Acquisition Module
	AM_adc_sclk: input;
	AM_adc_convst: input;
	AM_addr_inc: input;
	AM_addr_clr: input;
	AM_busy: input;
	AM_we_n: input;
	AM_cs_n: input;
	AM_data[7..0]: input;
	AM_adc_sdi[5..0]: output;
	AM_changing_mode: output;
	AM_data_bus_out: input;
	
	-- Read Data Module
	RDM_mode[1..0]: output;
	RDM_SCLK: output;
	RDM_data_read[7..0]: output;
	RDM_changing_mode: output;
	RDM_addr_clr: input;
	RDM_addr_inc: input;
	RDM_oe_n: input;
	RDM_cs_n: input;
	RDM_MISO: input;
	RDM_busy: input;
	RDM_MOSI: output;
	RDM_we_n: input;
	RDM_data_write[7..0]: input;
	RDM_data_bus_out: input;
)
begin
	-- Modes
	RI_mode[] = HI_mode[];
	RDM_mode[] = HI_mode[];
	AI_changing_mode = HI_changing_mode;
	RI_changing_mode = HI_changing_mode;
	AM_changing_mode = HI_changing_mode;
	RDM_changing_mode = HI_changing_mode;
	HI_busy = RDM_busy or AM_busy;

	case HI_mode[] is
		when MODE_CONFIGURATION =>
			-- Host Interface
			HI_MISO = AI_sdi[5];
			
			-- RAM Interface
			RI_addr_clr = Gnd;
			RI_addr_inc = Gnd;
			RI_data_in[] = Gnd;
			RI_we_n = Vcc;
			RI_oe_n = Vcc;
			RI_cs_n = Vcc;
			RI_data_bus_out = Gnd;
			
			-- ADC Interface
			AI_rst_n = HI_rst_n;
			AI_convst = HI_convst_start;
			AI_sclk = HI_SCLK;
			AI_sdo[0] = HI_MOSI;		-- Daisy-chain
			AI_sdo[5..1] = AI_sdi[4..0];
			
			-- Acquisition Module
			AM_adc_sdi[] = Gnd;
						
		when MODE_AQUISITION =>
			-- Host Interface
			
			-- RAM Interface
			RI_addr_clr = AM_addr_clr;
			RI_addr_inc = AM_addr_inc;
			RI_data_in[] = AM_data[];
			RI_we_n = AM_we_n;
			RI_oe_n = Vcc;
			RI_cs_n = AM_cs_n;
			RI_data_bus_out = AM_data_bus_out;
			
			-- ADC Interface
			AI_rst_n = Vcc;
			AI_convst = AM_adc_convst;
			AI_sclk = AM_adc_sclk;
			AI_sdo[] = Gnd;
			
			-- Acquisition Module
			AM_adc_sdi[] = AI_sdi[];

		when MODE_RW_DATA =>
			-- Host Interface		
			HI_MISO = RDM_MISO;
			
			-- RAM Interface
			RI_addr_clr = RDM_addr_clr;
			RI_addr_inc = RDM_addr_inc;
			RI_data_in[] = RDM_data_write;
			RI_we_n = RDM_we_n;
			RI_oe_n = RDM_oe_n;
			RI_cs_n = RDM_cs_n;
			RI_data_bus_out = RDM_data_bus_out;

			
			-- ADC Interface
			AI_rst_n = Vcc;
			AI_convst = Gnd;
			AI_sclk = Gnd;
			AI_sdo[0] = Gnd;		-- Daisy-chain
			AI_sdo[5..1] = AI_sdi[4..0];
			
			-- Acquisition Module
			AM_adc_sdi[] = Gnd;

			-- Read Data Module
			RDM_SCLK = HI_SCLK;
			RDM_data_read[] = RI_data_out[];
			RDM_MOSI = HI_MOSI;
		
		when others =>
			-- Host Interface
			
			-- RAM Interface
			RI_addr_clr = Gnd;
			RI_addr_inc = Gnd;
			RI_data_in[] = Gnd;
			RI_we_n = Vcc;
			RI_oe_n = Vcc;
			RI_cs_n = Vcc;
			RI_data_bus_out = Gnd;
			
			-- ADC Interface
			AI_rst_n = Vcc;
			AI_convst = Gnd;
			AI_sclk = Gnd;
			AI_sdo[] = Gnd;
			
			-- Acquisition Module
			AM_adc_sdi[] = Gnd;

		end case;
end;
