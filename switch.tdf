include "modes.inc";

subdesign switch(
	clk: input;
	reset: input;
	
	-- Host Interface
	HI_mode[1..0]: input;
	HI_changing_mode: input;
	HI_convst_start: input;
	HI_rst_n: input;
	HI_running: output;
	HI_SCLK: input;
	HI_MOSI: input;
	HI_MISO: output;
	HI_SS_n: input;
	
	-- RAM Interface
	RI_data_out[7..0]: input;
	RI_addr_clr: output;
	RI_addr_inc: output;
	RI_data_in[7..0]: output;
	RI_we_n: output;
	RI_cs_n: output;
	RI_mode[1..0]: output;
	RI_changing_mode: output;
	
	-- ADC Interface
	AI_sdi[5..0]: input;
	AI_changing_mode: output;
	AI_rst_n: output;
	AI_convst: output;
	AI_sclk: output;
	AI_sdo[5..0]: output;
	
	-- Acquisition Module
	AM_adc_sclk: input;
	AM_adc_convst: input;
	AM_addr_inc: input;
	AM_addr_clr: input;
	AM_running: input;
	AM_we_n: input;
	AM_cs_n: input;
	AM_data[7..0]: input;
	AM_adc_sdi[5..0]: output;
	AM_changing_mode: output;
)
begin
	-- Modes
	RI_mode[] = HI_mode[];
	AI_changing_mode = HI_changing_mode;
	RI_changing_mode = HI_changing_mode;
	AM_changing_mode = HI_changing_mode;

	case HI_mode[] is
--		when MODE_NONE =>	
		when MODE_CONFIGURATION =>
			HI_running = Gnd;
			
			-- RAM Interface
			RI_addr_clr = Gnd;
			RI_addr_inc = Gnd;
			RI_data_in[] = Gnd;
			RI_we_n = Vcc;
			RI_cs_n = Vcc;
			
			-- ADC Interface
			AI_rst_n = HI_rst_n;
			AI_convst = HI_convst_start;
			AI_sclk = HI_SCLK;
			AI_sdo[0] = HI_MOSI;		-- Daisy-chain
			HI_MISO = AI_sdi[5];
			AI_sdo[5..1] = AI_sdi[4..0];
			
			-- Acquisition Module
			AM_adc_sdi[] = Gnd;
			
		when MODE_AQUISITION =>
			-- Host Interface
			HI_running = AM_running;
			
			-- RAM Interface
			RI_addr_clr = AM_addr_clr;
			RI_addr_inc = AM_addr_inc;
			RI_data_in[] = AM_data[];
			RI_we_n = AM_we_n;
			RI_cs_n = AM_cs_n;
			
			-- ADC Interface
			AI_rst_n = Vcc;
			AI_convst = AM_adc_convst;
			AI_sclk = AM_adc_sclk;
			AI_sdo[] = Gnd;
			
			-- Acquisition Module
			AM_adc_sdi[] = AI_sdi[];

--		when MODE_READ_DATA =>
		when others =>
			HI_running = Gnd;
			
			-- RAM Interface
			RI_addr_clr = Gnd;
			RI_addr_inc = Gnd;
			RI_data_in[] = Gnd;
			RI_we_n = Vcc;
			RI_cs_n = Vcc;
			
			-- ADC Interface
			AI_rst_n = Vcc;
			AI_convst = Gnd;
			AI_sclk = Gnd;
			AI_sdo[] = Gnd;
			
			-- Acquisition Module
			AM_adc_sdi[] = Gnd;

		end case;
end;
