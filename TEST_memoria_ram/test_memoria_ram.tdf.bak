include "lpm_counter.inc";
PARAMETERS
(
		N_BITS = 19
);


subdesign test_memoria_RAM(
	clk: input;
	addr_out[3..0]: output;
	data_out[7..0]: output;
)
variable
	address_counter: lpm_counter with(LPM_DIRECTION="UP", LPM_WIDTH = N_BITS);
	sm: machine with states (init, grava, le);
begin
	sm.clk = clk;
	
	case sm is
		when init =>
			sm = grava;
			
		when grava =>
			if address_counter.q[4] then
				sm = le;
			else
				sm = grava;
			end if;
		when le =>
			if address_counter.q[4] then
				sm = grava;
			else
				sm = le;
			end if;
end;