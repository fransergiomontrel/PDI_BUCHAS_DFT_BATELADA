		LEVEL 0 FOR 8.0;
		LEVEL 1 FOR 40.0;
		LEVEL 0 FOR 52.0;
	}
}

TRANSITION_LIST("o[1]")
{
	NODE
	{
		REPEAT = 1;
		LEVEL X FOR 100.0;
	}
}

TRANSITION_LIST("o[0]")
{
	NODE
	{
		REPEAT = 1;
		LEVEL X FOR 100.0;
	}
}

