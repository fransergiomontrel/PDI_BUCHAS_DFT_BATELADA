	.clk(\clk~combout ),
	.dataa(vcc),
	.datab(\sreset~combout ),
	.datac(cont[1]),
	.datad(cont[0]),
	.aclr(gnd),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\inc~combout ),
	.cin(gnd),
	.cin0(gnd),
	.cin1(vcc),
	.inverta(gnd),
	.regcascin(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.combout(),
	.regout(cont[1]),
	.cout(),
	.cout0(),
	.cout1());
// synopsys translate_off
defparam \cont[1] .lut_mask = "0330";
