defparam \cont[1] .sum_lutc_input = "datac";
defparam \cont[1] .synch_mode = "off";
// synopsys translate_on

// Location: LC_X3_Y9_N4
maxii_lcell \cont[2] (
// Equation(s):
// cont[2] = DFFEAS((!\sreset~combout  & (cont[2] $ (((cont[1] & cont[0]))))), GLOBAL(\clk~combout ), VCC, , \inc~combout , , , , )

	.clk(\clk~combout ),
	.dataa(cont[1]),
	.datab(\sreset~combout ),
	.datac(cont[2]),
	.datad(cont[0]),
	.aclr(gnd),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\inc~combout ),
	.cin(gnd),
	.cin0(gnd),
	.cin1(vcc),
	.inverta(gnd),
