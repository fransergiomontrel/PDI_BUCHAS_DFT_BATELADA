	.clk(\clk~combout ),
	.dataa(vcc),
	.datab(\sreset~combout ),
	.datac(vcc),
	.datad(cont[0]),
	.aclr(gnd),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\inc~combout ),
	.cin(gnd),
	.cin0(gnd),
	.cin1(vcc),
	.inverta(gnd),
	.regcascin(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.combout(),
	.regout(cont[0]),
	.cout(),
	.cout0(),
	.cout1());
