`timescale 1 ps/ 1 ps
module host_interface_vlg_vec_tst();
// constants                                           
// general purpose registers
reg busy;
reg clk;
reg host_convst_start;
reg [1:0] host_mode;
reg host_MOSI;
reg host_rst_n;
reg host_SCLK;
reg MISO;
reg sreset;
// wires                                               
wire changing_mode;
wire convst_start;
wire host_busy;
wire host_MISO;
wire [1:0] mode;
wire MOSI;
wire rst_n;
wire SCLK_;
wire sreset_mode0;
wire sreset_mode1;
wire sreset_mode2;
wire sreset_mode3;

// assign statements (if any)                          
host_interface i1 (
// port map - connection between master ports and signals/registers   
	.busy(busy),
	.changing_mode(changing_mode),
	.clk(clk),
	.convst_start(convst_start),
	.host_busy(host_busy),
	.host_convst_start(host_convst_start),
	.host_MISO(host_MISO),
	.host_mode(host_mode),
	.host_MOSI(host_MOSI),
	.host_rst_n(host_rst_n),
	.host_SCLK(host_SCLK),
	.MISO(MISO),
	.mode(mode),
	.MOSI(MOSI),
	.rst_n(rst_n),
	.SCLK_(SCLK_),
	.sreset(sreset),
	.sreset_mode0(sreset_mode0),
	.sreset_mode1(sreset_mode1),
	.sreset_mode2(sreset_mode2),
	.sreset_mode3(sreset_mode3)
);
initial 
begin 
#2000000 $finish;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// sreset
initial
begin
	sreset = 1'b1;
	sreset = #100000 1'b0;
end 
// host_mode[ 1 ]
initial
begin
	repeat(2)
	begin
		host_mode[1] = 1'b0;
		host_mode[1] = #400000 1'b1;
		# 400000;
	end
	host_mode[1] = 1'b0;
end 
// host_mode[ 0 ]
always
begin
	host_mode[0] = 1'b0;
	host_mode[0] = #200000 1'b1;
	#200000;
end 
