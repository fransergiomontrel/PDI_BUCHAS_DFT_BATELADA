`timescale 1 ps/ 1 ps
module teste_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg clr;
reg inc;
reg reset;
// wires                                               
wire [3:0] o;

// assign statements (if any)                          
teste i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.clr(clr),
	.inc(inc),
	.o(o),
	.reset(reset)
);
initial 
begin 
#1000000 $finish;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// clr
initial
begin
	repeat(2)
	begin
		clr = 1'b0;
		clr = #50000 1'b1;
		# 50000;
	end
	clr = 1'b0;
	clr = #350000 1'b1;
	# 50000;
	repeat(4)
	begin
		clr = 1'b0;
		clr = #50000 1'b1;
		# 50000;
	end
end 

// inc
always
begin
	inc = 1'b0;
	inc = #100000 1'b1;
	#100000;
end 

// reset
initial
begin
	reset = 1'b0;
	reset = #140000 1'b1;
	reset = #10000 1'b0;
end 
endmodule

