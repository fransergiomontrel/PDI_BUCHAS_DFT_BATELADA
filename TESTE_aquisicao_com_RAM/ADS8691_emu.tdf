include "spi_shift_v2.inc";
include "counter.inc";

parameters(	OFF_SET = 0
);

subdesign ADS8691_emu(
	convst: input;
	sdo: output;
	sdi: input;
	sclk_: input;
	
	test_shift_tx[31..0]: output;
	test_counter[2..0]: output;
)
variable
	spi: spi_shift_v2 with (N_BITS = 32);
	c: counter with (MAX_VALUE = 7);
begin
	spi.clk = sclk_;
	spi.async_load = convst;
	spi.MOSI = sdi;
	sdo = spi.MISO;
	c.clk = !convst;
	c.inc = Vcc;
	
	TABLE
		c.o[]+OFF_SET	=> spi.parallel_in[];
		0					=>	h"12345678";
		1					=>	h"9ABCDEF1";
		2					=>	h"23456789";
		3					=>	h"ABCDEF01";
		4					=>	h"23456789";
		5					=>	h"01234567";
		6					=>	h"6789ABCD";
		7					=>	h"EF012345";
	END TABLE;

	test_counter[] = c.o[];
	test_shift_tx[] = spi.test_shift_tx[];
end;