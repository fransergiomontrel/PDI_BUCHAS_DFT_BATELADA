include "spi_shift_v2.inc";
include "counter.inc";
include "modes.inc";
include "dffes.inc";
include "dft_locale.inc";
include "luts.inc";


subdesign rw_data_module(
	clk: input;
	sreset: input;
	done_tx: input;
	start_tx: output;
	
	addr_clr: output;
	addr_inc_read: output;
	addr_inc_write: output;
	oe_n: output;
	we_n: output;
	cs_n: output;
	
	SCLK_: input;
	MISO: output;
	MOSI: input;
	
	data_read[15..0]: input;
	data_write[15..0]: output;
	
	busy: output;
	
	data_bus_out: output;
	ready: output;
	
	
	data_out_to_uart_tx[383..0]: output;
	
)
variable
	shift: spi_shift_v2 with (N_BITS=16);
	
	sm: machine with states(rst, init, init_buffers1, init_buffers2, init_buffers3, init_buffers4, load_sync1, load_sync2, load_sync3, load_sync4, wait_loading, wr1, wr2, wr3, wr4, wr5, wr6, wait_loading_n);
	
	oe_n_FF, we_n_FF, cs_n_FF, load_parallel_FF, busy_ff, data_bus_out_ff, SCLK_ff, MOSI_ff: dffes;
	buffer_parallel_in[15..0]: dffe;
	ready_ff: srff;
	--DFT result bus of 48 bytes to send through tx UART when requested
	dft_result[11..0][31..0], start_tx_ff: dff;
	
	--Module which call dft modules
	dft_caller : dft_locale;
	--Module that retrive UFM data
	luts_table: luts;
	
begin
	defaults
  		addr_clr = Gnd;
		addr_inc_read = Gnd;
		addr_inc_write = Gnd;
		cs_n_FF.d = Gnd;
		oe_n_FF.d = Vcc;
		we_n_FF.d = Vcc;
		load_parallel_FF.d = Gnd;
		busy_ff.d = Gnd;
		data_bus_out_ff.d = Gnd;
		buffer_parallel_in[].ena = Gnd;
		ready_ff.s = Gnd;
		ready_ff.r = Gnd;
	end defaults;
	
	--Connections of dft result bus
	dft_result[][].clk = clk; 
	dft_result[][].clrn = !sreset;
	
	--Connections ff to start uart tx
	start_tx_ff.clk = clk;
	start_tx_ff.clrn = !sreset & !done_tx;
	start_tx = start_tx_ff.q;
	
	--Conections of dft_locale 1
	dft_caller.clk = clk;
	dft_caller.sreset = sreset;
	dft_caller.byte_channel[] = data_read[];
	dft_caller.new_byte = addr_inc_read;
	dft_caller.enable_read = oe_n;
	dft_caller.end_tx = done_tx;
	luts_table.addr = dft_caller.step_ufm_addr[];
	
	dft_result[0][].d = dft_caller.cos_out1[];
	dft_result[1][].d = dft_caller.sin_out1[];
	
	dft_result[2][].d = dft_caller.cos_out2[];
	dft_result[3][].d = dft_caller.sin_out2[];
	
	dft_result[4][].d = dft_caller.cos_out3[];
	dft_result[5][].d = dft_caller.sin_out3[];
	
	dft_result[6][].d = dft_caller.cos_out4[];
	dft_result[7][].d = dft_caller.sin_out4[];
	
	dft_result[8][].d = dft_caller.cos_out5[];
	dft_result[9][].d = dft_caller.sin_out5[];
	
	dft_result[10][].d = dft_caller.cos_out6[];
	dft_result[11][].d = dft_caller.sin_out6[];
	
		
	--Lock level of last dft
	 start_tx_ff.d = dft_caller.start_tx # start_tx_ff;
	 
	 --Permanent connections of ufm module
	luts_table.clk = clk;
	luts_table.clk = rst;
	luts_table.addr = dft_caller.step_ufm_addr;
	dft_caller.luts_value[] = (luts_table.sin[], luts_table.cos[]);
	
	--Connect array dft bus to output which in data in to uart tx
	data_out_to_uart_tx[31..0] = dft_result[0][].q;
	data_out_to_uart_tx[63..32] = dft_result[1][].q;
	data_out_to_uart_tx[95..64] = dft_result[2][].q;
	data_out_to_uart_tx[127..96] = dft_result[3][].q;
	data_out_to_uart_tx[159..128] = dft_result[4][].q;
	data_out_to_uart_tx[191..160] = dft_result[5][].q;
	data_out_to_uart_tx[223..192] = dft_result[6][].q;
	data_out_to_uart_tx[255..224] = dft_result[7][].q;
	data_out_to_uart_tx[287..256] = dft_result[8][].q;
	data_out_to_uart_tx[319..288] = dft_result[9][].q;
	data_out_to_uart_tx[351..320] = dft_result[10][].q;
	data_out_to_uart_tx[383..352] = dft_result[11][].q;
			
	
	ready_ff.clk = clk;
	ready = ready_ff.q;
	ready_ff.clrn = !sreset;
	
	SCLK_ff.clk = clk;
	SCLK_ff.d = SCLK_;
	
	MOSI_ff.clk = clk;
	MOSI_ff.d = MOSI;
	
	shift.clk = SCLK_ff.q;
	shift.parallel_in[] = buffer_parallel_in[].q;
	shift.MOSI = MOSI_ff.q;

	oe_n_FF.clk = clk;
	oe_n = oe_n_FF.q;
	oe_n_FF.spre = sreset;

	cs_n_FF.clk = clk;
	cs_n = cs_n_FF.q;
	cs_n_FF.spre = sreset;

	we_n_FF.clk = clk;
	we_n = we_n_FF.q;
	we_n_FF.spre = sreset;

	data_bus_out_ff.clk = clk;
	data_bus_out = data_bus_out_ff.q;
	data_bus_out_ff.sclr = sreset;
	
	buffer_parallel_in[].clk = clk;
	buffer_parallel_in[].d = data_read[];
	buffer_parallel_in[].clrn = !(load_parallel_FF.q and !data_read[]);
	buffer_parallel_in[].prn  = !(load_parallel_FF.q and  data_read[]);
    
	load_parallel_FF.clk = clk;
	shift.async_load = load_parallel_FF.q;
	load_parallel_FF.spre = sreset;
	
	busy_ff.clk = clk;
	busy = busy_ff.q;
	busy_ff.sclr = sreset;

	sm.reset = sreset;
	sm.clk = clk;
	
	case sm is
		when rst =>
			cs_n_FF.d = Vcc;
			ready_ff.r = Vcc;
			sm = init;
			
		when init =>
			addr_clr = Vcc;
			busy_ff.d = Vcc;
			load_parallel_FF.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers1;
		
		when init_buffers1 =>					-- 4 estados para dar temporização suficiente da leitura da RAM (taa)
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers2;

		when init_buffers2 =>
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers3;

		when init_buffers3 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers4;

		when init_buffers4 =>
			addr_inc_read = Vcc;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync1;			
			
		when load_sync1 =>					-- 4 estados para dar temporização suficiente da leitura da RAM (taa)
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync2;

		when load_sync2 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync3;

		when load_sync3 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			buffer_parallel_in[].ena = Vcc;
			sm = load_sync4;

		when load_sync4 =>
			addr_inc_read = Vcc;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = wait_loading;
		
		when wait_loading =>
			ready_ff.s = Vcc;
			oe_n_FF.d = Gnd;
			if !shift.loading_tx then
				sm = wait_loading;
			else
				sm = wr1;
			end if;

		when wr1 =>
			busy_ff.d = Vcc;
			sm = wr2;

		when wr2 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr3;

		when wr3 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr4;

		when wr4 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr5;

		when wr5 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr6;

		when wr6 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			addr_inc_write = Vcc;
			sm = wait_loading_n;

		when wait_loading_n =>
			oe_n_FF.d = Gnd;
			if shift.loading_tx then
				sm = wait_loading_n;
			else
				sm = load_sync1;
			end if;
	end case;
	
	MISO = shift.MISO;
	
	data_write[] = shift.parallel_out[];
--	data_write[] = h"A5";

	
	TABLE
		sm					=> test_state[];
		rst 				=>	0;
		init 				=>	1;
		init_buffers1 	=>	2;
		init_buffers2 	=>	3;
		init_buffers3 	=>	4;
		init_buffers4 	=>	5;
		load_sync1		=> 6;
		load_sync2		=> 7;
		load_sync3		=> 8;
		load_sync4		=> 9;
		wait_loading 	=>	10;
		wr1				=>	11;
		wr2				=>	12;
		wr3				=>	13;
		wr4				=>	14;
		wr5				=>	15;
		wr6				=>	16;
		wait_loading_n	=>	17;
	END TABLE;
end;