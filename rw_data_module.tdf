include "spi_shift.inc";
include "counter.inc";
include "modes.inc";
include "dffes.inc";

subdesign rw_data_module(
	clk: input;
	sreset: input;
	
	changing_mode: input;
	mode[1..0]: input;
	addr_clr: output;
	addr_inc: output;
	oe_n: output;
	we_n: output;
	cs_n: output;
	
	SCLK_: input;
	MISO: output;
	MOSI: input;
	
	data_read[7..0]: input;
	data_write[7..0]: output;
	
	busy: output;
	
	data_bus_out: output;
	
	test_async_load: output;
	test_loading: output;
	test_state[3..0]: output;
	test_data_shift[7..0]: output;
)
variable
	shift: spi_shift with (N_BITS=8);
	
	sm: machine with states(wait_mode, init_buffers1, init_buffers2, init_buffers3, init_buffers4, wait_loading, wait_loading_n, wr1, wr2, wr3, wr4, wr5, wr6);
	
	oe_n_FF, we_n_FF, cs_n_FF, load_parallel_FF, addr_inc_FF, busy_ff, data_bus_out_ff, SCLK_ff, MOSI_ff: dffes;
begin
	defaults
		addr_clr = Gnd;
		addr_inc = Gnd;
		cs_n_FF.d = Gnd;
		oe_n_FF.d = Vcc;
		we_n_FF.d = Vcc;
		load_parallel_FF.d = Gnd;
		addr_inc_FF.d = GND;
		busy_ff.d = Gnd;
		data_bus_out_ff.d = Gnd;
	end defaults;
	
	SCLK_ff.clk = clk;
	SCLK_ff.d = SCLK_;
	
	MOSI_ff.clk = clk;
	MOSI_ff.d = MOSI;
	
	shift.clk = SCLK_ff.q;
	shift.parallel_in[] = data_read[];
	shift.MOSI = MOSI_ff.q;

	oe_n_FF.clk = clk;
	oe_n = oe_n_FF.q;
	oe_n_FF.spre = sreset;

	cs_n_FF.clk = clk;
	cs_n = cs_n_FF.q;
	cs_n_FF.spre = sreset;

	we_n_FF.clk = clk;
	we_n = we_n_FF.q;
	we_n_FF.spre = sreset;

	data_bus_out_ff.clk = clk;
	data_bus_out = data_bus_out_ff.q;
	data_bus_out_ff.sclr = sreset;

	load_parallel_FF.clk = clk;
	shift.async_load = load_parallel_FF.q;
	load_parallel_FF.spre = sreset;
	
	addr_inc_FF.clk = clk;
	addr_inc = addr_inc_FF.q;
	addr_inc_FF.sclr = sreset;
	
	busy_ff.clk = clk;
	busy = busy_ff.q or changing_mode;
	busy_ff.sclr = sreset;

	sm.reset = sreset;
	sm.clk = clk;
	
	case sm is
		when wait_mode =>
			if mode[] == MODE_RW_DATA and !changing_mode then
				addr_clr = Vcc;
				busy_ff.d = Vcc;
				load_parallel_FF.d = Vcc;
				oe_n_FF.d = Gnd;
				sm = init_buffers1;
			else
				cs_n_FF.d = Vcc;
				sm = wait_mode;
			end if;

		when init_buffers1 =>					-- 4 estados para dar temporização suficiente da leitura da RAM (taa)
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers2;

		when init_buffers2 =>
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers3;

		when init_buffers3 =>
			oe_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			sm = init_buffers4;

		when init_buffers4 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = wait_loading;
		
		when wait_loading =>
			if mode[] == MODE_RW_DATA and !changing_mode then
				oe_n_FF.d = Gnd;
				if !shift.loading then
					sm = wait_loading;
				else
					sm = wait_loading_n;
				end if;
			else
				cs_n_FF.d = Vcc;
				sm = wait_mode;
			end if;

		when wait_loading_n =>
			if mode[] == MODE_RW_DATA and !changing_mode then
				oe_n_FF.d = Gnd;
				if shift.loading then
					sm = wait_loading_n;
				else
					sm = wr1;
				end if;
			else
				cs_n_FF.d = Vcc;
				sm = wait_mode;
			end if;

		when wr1 =>
			busy_ff.d = Vcc;
			sm = wr2;

		when wr2 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr3;

		when wr3 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr4;

		when wr4 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr5;

		when wr5 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			addr_inc_FF.d = Vcc;
			sm = wr6;

		when wr6 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers1;
	end case;
	
	MISO = shift.MISO;
	
	data_write[] = shift.parallel_out[];
--	data_write[] = h"A5";

	
	-- TESTS
	test_async_load = load_parallel_FF.q;
	test_loading = shift.loading;
	test_data_shift[] = shift.test_data_shift[];
	
	TABLE
		sm					=> test_state[];
		wait_mode 		=>	0;
		init_buffers1 	=>	1;
		init_buffers2 	=>	2;
		init_buffers3 	=>	3;
		init_buffers4 	=>	4;
		wait_loading 	=>	5;
		wait_loading_n	=>	6;
		wr1				=>	7;
		wr2				=>	8;
		wr3				=>	9;
		wr4				=>	10;
		wr5				=>	11;
		wr6				=>	12;
	END TABLE;
end;