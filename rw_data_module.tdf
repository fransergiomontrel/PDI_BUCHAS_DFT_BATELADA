include "spi_shift_v2.inc";
include "counter.inc";
include "modes.inc";
include "dffes.inc";

subdesign rw_data_module(
	clk: input;
	sreset: input;
	
	addr_clr: output;
	addr_inc_read: output;
	addr_inc_write: output;
	oe_n: output;
	we_n: output;
	cs_n: output;
	
	SCLK_: input;
	MISO: output;
	MOSI: input;
	
	data_read[7..0]: input;
	data_write[7..0]: output;
	
	busy: output;
	
	data_bus_out: output;
	ready: output;
	
	test_async_load: output;
	test_loading: output;
	test_state[5..0]: output;
	test_data_shift[7..0]: output;
	test_shift_rx[6..0]: output;
)
variable
	shift: spi_shift_v2 with (N_BITS=8);
	
	sm: machine with states(rst, init, init_buffers1, init_buffers2, init_buffers3, init_buffers4, load_sync1, load_sync2, load_sync3, load_sync4, wait_loading, wr1, wr2, wr3, wr4, wr5, wr6, wait_loading_n);
	
	oe_n_FF, we_n_FF, cs_n_FF, load_parallel_FF, busy_ff, data_bus_out_ff, SCLK_ff, MOSI_ff: dffes;
	buffer_parallel_in[7..0]: dffe;
	ready_ff: srff;
begin
	defaults
		addr_clr = Gnd;
		addr_inc_read = Gnd;
		addr_inc_write = Gnd;
		cs_n_FF.d = Gnd;
		oe_n_FF.d = Vcc;
		we_n_FF.d = Vcc;
		load_parallel_FF.d = Gnd;
		busy_ff.d = Gnd;
		data_bus_out_ff.d = Gnd;
		buffer_parallel_in[].ena = Gnd;
		ready_ff.s = Gnd;
		ready_ff.r = Gnd;
	end defaults;
	
	ready_ff.clk = clk;
	ready = ready_ff.q;
	ready_ff.clrn = !sreset;
	
	SCLK_ff.clk = clk;
	SCLK_ff.d = SCLK_;
	
	MOSI_ff.clk = clk;
	MOSI_ff.d = MOSI;
	
	shift.clk = SCLK_ff.q;
	shift.parallel_in[] = buffer_parallel_in[].q;
	shift.MOSI = MOSI_ff.q;

	oe_n_FF.clk = clk;
	oe_n = oe_n_FF.q;
	oe_n_FF.spre = sreset;

	cs_n_FF.clk = clk;
	cs_n = cs_n_FF.q;
	cs_n_FF.spre = sreset;

	we_n_FF.clk = clk;
	we_n = we_n_FF.q;
	we_n_FF.spre = sreset;

	data_bus_out_ff.clk = clk;
	data_bus_out = data_bus_out_ff.q;
	data_bus_out_ff.sclr = sreset;
	
	buffer_parallel_in[].clk = clk;
	buffer_parallel_in[].d = data_read[];
	buffer_parallel_in[].clrn = !(load_parallel_FF.q and !data_read[]);
	buffer_parallel_in[].prn  = !(load_parallel_FF.q and  data_read[]);


	load_parallel_FF.clk = clk;
	shift.async_load = load_parallel_FF.q;
	load_parallel_FF.spre = sreset;
	
	busy_ff.clk = clk;
	busy = busy_ff.q;
	busy_ff.sclr = sreset;

	sm.reset = sreset;
	sm.clk = clk;
	
	case sm is
		when rst =>
			cs_n_FF.d = Vcc;
			ready_ff.r = Vcc;
			sm = init;
			
		when init =>
			addr_clr = Vcc;
			busy_ff.d = Vcc;
			load_parallel_FF.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers1;
		
		when init_buffers1 =>					-- 4 estados para dar temporização suficiente da leitura da RAM (taa)
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers2;

		when init_buffers2 =>
			load_parallel_FF.d = load_parallel_FF.q;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers3;

		when init_buffers3 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = init_buffers4;

		when init_buffers4 =>
			addr_inc_read = Vcc;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync1;			
			
		when load_sync1 =>					-- 4 estados para dar temporização suficiente da leitura da RAM (taa)
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync2;

		when load_sync2 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = load_sync3;

		when load_sync3 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			buffer_parallel_in[].ena = Vcc;
			sm = load_sync4;

		when load_sync4 =>
			addr_inc_read = Vcc;
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			sm = wait_loading;
		
		when wait_loading =>
			ready_ff.s = Vcc;
			oe_n_FF.d = Gnd;
			if !shift.loading_tx then
				sm = wait_loading;
			else
				sm = wr1;
			end if;

		when wr1 =>
			busy_ff.d = Vcc;
			sm = wr2;

		when wr2 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr3;

		when wr3 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr4;

		when wr4 =>
			we_n_FF.d = Gnd;
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr5;

		when wr5 =>
			busy_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = wr6;

		when wr6 =>
			busy_ff.d = Vcc;
			oe_n_FF.d = Gnd;
			addr_inc_write = Vcc;
			sm = wait_loading_n;

		when wait_loading_n =>
			oe_n_FF.d = Gnd;
			if shift.loading_tx then
				sm = wait_loading_n;
			else
				sm = load_sync1;
			end if;
	end case;
	
	MISO = shift.MISO;
	
	data_write[] = shift.parallel_out[];
--	data_write[] = h"A5";

	
	-- TESTS
	test_async_load = load_parallel_FF.q;
	test_loading = shift.loading_tx;
	test_data_shift[] = shift.test_shift_tx[];
	test_shift_rx[] = shift.test_shift_rx[];
	
	TABLE
		sm					=> test_state[];
		rst 				=>	0;
		init 				=>	1;
		init_buffers1 	=>	2;
		init_buffers2 	=>	3;
		init_buffers3 	=>	4;
		init_buffers4 	=>	5;
		load_sync1		=> 6;
		load_sync2		=> 7;
		load_sync3		=> 8;
		load_sync4		=> 9;
		wait_loading 	=>	10;
		wr1				=>	11;
		wr2				=>	12;
		wr3				=>	13;
		wr4				=>	14;
		wr5				=>	15;
		wr6				=>	16;
		wait_loading_n	=>	17;
	END TABLE;
end;