parameters(
	MODULE = 5
);


constant NUM_BITS = log2(MODULE);
constant MAX_CONT = MODULE-1;

subdesign divfreq(
	clk: input;
	out: output;
)
variable
	IF NUM_BITS > 1 GENERATE
		ffs[NUM_BITS-1..0]: dff;
	ELSE GENERATE
		ffs[0]: dff;
	END GENERATE;

begin
	ffs[].clk = clk;
	out = ffs[NUM_BITS-1].q;

	IF NUM_BITS > 1 GENERATE
		if ffs[].q == MAX_CONT then
			ffs[].d = 0;
		else
			ffs[].d = ffs[].q+1;
		end if;
	ELSE GENERATE
		ffs[].d = !ffs[].q;
	END GENERATE;

end;