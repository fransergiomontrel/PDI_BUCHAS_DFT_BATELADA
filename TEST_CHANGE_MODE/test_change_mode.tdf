-- Este teste avalia a mudança entre os diversos modos conforme a sequencia abaixo:
--     
--    MODE_NONE;
--    MODE_CONFIGURATION;
--    MODE_NONE;
--    MODE_AQUISITION;
--    MODE_NONE;
--    MODE_READ_DATA;
--    MODE_NONE;
--    MODE_CONFIGURATION;
--    MODE_AQUISITION;
--    MODE_CONFIGURATION;
--    MODE_READ_DATA;
--    MODE_CONFIGURATION;
--    MODE_AQUISITION;
--    MODE_READ_DATA;
--    MODE_AQUISITION;
--
-- Os sinais monitorados na troca de modo são:
--
-- host_mode		-> para verificar em que modo está
-- host_busy		-> para avaliar se completa amudança de modo
-- RAM_cs			-> para ter certeza de que não habilita por acidente a memória (só pode habilitar no estado MODE_READ_DATA para ler os dados para a serialização)
-- RAM_we_n			-> para garantir que não há nenhuma escrita na memória enquanto RAM_cs está habilitado
-- adc_SCLK			-> para ter serteza que nenhum pulso de clock é fornecido ao ADC
-- adc_convst[0]	-> para ter certeza que nenhum pulso de CONVST (diparo de conversão) é realizado
-- adc_rst_n[0]	-> para ter certeza que nenhum pulso de reset é gerado nos ADCs

include "counter.inc";
include "sensor_buchas_CPLD.inc";
include "modes.inc";
include "divfreq.inc";

CONSTANT STATE_NONE = h"F";


subdesign test_change_mode(
	clk, rst: input;
	
	host_mode[1..0]: output;
	host_busy: output;
	RAM_cs_n: output;
	RAM_we_n: output;
	adc_convst: output;
	adc_rst_n: output;
	
	state_test[3..0]: output;
	pause_test[3..0]: output;
	run_test: output;
)
variable
	s: sensor_buchas_CPLD;
	state[3..0]: dffe;
	pause: counter with (MAX_VALUE = 1000);
	mode[1..0]: node;
	run, next_state[3..0]: node;
	mode_ff[1..0]: dffe;
	clock: node;
	
	c[5..0]: dff;
begin
	defaults
		run = Gnd;
		next_state[] = h"F";
	end defaults;
	
	c[].clk = clk;
	c[].d = c[].q+1;
	c[].clrn = !rst;

	s.clk = clk;
	s.rst = rst;
	host_busy = s.host_busy;
	s.host_convst_start = c[1].q and mode_ff[].q == MODE_CONFIGURATION;
	s.host_rst_n = c[1].q;
	RAM_cs_n = s.RAM_cs_n;
	RAM_we_n = s.RAM_we_n;
	adc_convst = s.adc_convst[0];
	adc_rst_n = s.adc_rst_n[0];
	

	pause.clk = c[2].q;
	pause.clr = run;
	pause.inc = Vcc;
	pause.sreset = rst;
	pause_test[] = pause.o[3..0];
	
	
	state[].clk = c[2].q;
	state[].clrn = !rst;
	state_test[] = state[].q;
	state[].ena = run;
	state[].d = next_state[];

	run = (next_state[] != STATE_NONE);

	run_test = run;
	
	mode_ff[].clrn = !rst;
	mode_ff[].clk = c[2].q;
	mode_ff[].d = mode[];
	mode_ff[].ena = run;
	host_mode[] = mode_ff[].q;
	s.host_mode[] = mode_ff[].q;
		
	TABLE
		state[].q,	pause.o[]		=> 	next_state[],	mode[];
		0,				5					=> 	1,					MODE_NONE;
		1,				10					=> 	2,					MODE_CONFIGURATION;
		2,				10					=> 	3,					MODE_NONE;
		3,				10					=> 	4,					MODE_AQUISITION;
		4,				10					=> 	5,					MODE_NONE;
		5,				10					=> 	6,					MODE_READ_DATA;
		6,				15					=> 	7,					MODE_NONE;
		7,				10					=> 	8,					MODE_CONFIGURATION;
		8,				10					=> 	9,					MODE_AQUISITION;
		9,				10					=> 	10,				MODE_CONFIGURATION;
		10,			10					=> 	11,				MODE_READ_DATA;
		11,			15					=> 	12,				MODE_CONFIGURATION;
		12,			10					=> 	13,				MODE_AQUISITION;
		13,			10					=> 	14,				MODE_READ_DATA;
		14,			15					=> 	0,					MODE_AQUISITION;
	END TABLE;

end;