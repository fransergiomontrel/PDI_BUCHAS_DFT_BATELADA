PARAMETERS
(
	bus_size = 2
);


subdesign synchronizer
(
	clk: input;				-- Clock principal
	i[bus_size-1..0]: input;
	
	o[bus_size-1..0]: output;
)
variable
	regs[bus_size-1..0][4..0]: dffe;
begin
	regs[][0].clk = clk;
	regs[][1].clk = clk;
	regs[][2].clk = clk;
	regs[][3].clk = clk;
	regs[][0].d = i[];
	regs[][3..1].d = regs[][2..0].q;
	o[] = regs[][3].q;
	regs[][3].ena = (regs[][2] == regs[][1])and (regs[][1] == regs[][0]);
end;


-- CONSTANT __constant_name = __constant_value;
