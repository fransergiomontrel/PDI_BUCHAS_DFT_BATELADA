include "counter.inc";
include "dffes.inc";

subdesign acquisition_store_crc(
	clk: input;
	sreset: input;
	store_crc: input;
	
	we_n: output;
	cs_n: output;
	addr_inc_write: output;
	store_crc_ok: output;
	msb: output;
	data_bus_out: output;
	
	test_sm[3..0]: output;
)
variable	
	cs_n_ff, we_n_ff, data_bus_out_ff, msb_ff: dffes;
	
	sm: MACHINE WITH STATES(WAIT_STORE_CRC, WE1_CS0_LSBa, WE0_CS0_LSBa, WE0_CS0_LSBb, WE0_CS0_LSBc, WE1_CS0_LSBb, WE1_CS0_MSBa, WE0_CS0_MSBa, WE0_CS0_MSBb, WE0_CS0_MSBc, WE1_CS0_MSBb, WAIT_END);
begin
	defaults
		cs_n_ff.d = Gnd;
		we_n_ff.d = Vcc;
		data_bus_out_ff.d = Gnd;
		addr_inc_write = Gnd;
		store_crc_ok = Gnd;
		msb_ff.d = Gnd;
	end defaults;
	
	-- sresets
	sm.reset = sreset;
	cs_n_ff.spre = sreset;
	we_n_ff.spre = sreset;
	data_bus_out_ff.sclr = sreset;
	msb_ff.sclr = sreset;
	
	-- Sync data
	cs_n_ff.clk = clk;
	we_n_ff.clk = clk;
	data_bus_out_ff.clk = clk;
	sm.clk = clk;
	msb_ff.clk = clk;

	case sm IS
		WHEN WAIT_STORE_CRC =>
test_sm[] = 0;
			if store_crc then
				data_bus_out_ff.d = Vcc;
				sm = WE1_CS0_LSBa;
			else
				cs_n_ff.d = Vcc;
				sm = WAIT_STORE_CRC;
			end if;
			
		WHEN WE1_CS0_LSBa =>
			-- WE=1, CS=0, MSB=0
test_sm[] = 1;
			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			sm = WE0_CS0_LSBa;
			
		WHEN WE0_CS0_LSBa =>
			-- WE=0, CS=0, MSB=0
test_sm[] = 2;
			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			sm = WE0_CS0_LSBb;

		WHEN WE0_CS0_LSBb =>
			-- WE=0, CS=0, MSB=0
test_sm[] = 3;
			we_n_ff.d = Gnd;
			data_bus_out_ff.d = Vcc;
			sm = WE0_CS0_LSBc;
			
		WHEN WE0_CS0_LSBc =>
			-- WE=0, CS=0, MSB=0
test_sm[] = 4;
			data_bus_out_ff.d = Vcc;
			sm = WE1_CS0_LSBb;
			
		WHEN WE1_CS0_LSBb =>
			-- WE=1, CS=0, MSB=0
test_sm[] = 5;
			addr_inc_write = Vcc;
			msb_ff.d = Vcc;
			data_bus_out_ff.d = Vcc;
			sm = WE1_CS0_MSBa;

-- 
		WHEN WE1_CS0_MSBa =>
			-- WE=1, CS=0, MSB=1
test_sm[] = 6;
			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			msb_ff.d = Vcc;
			sm = WE0_CS0_MSBa;
			
		WHEN WE0_CS0_MSBa =>
			-- WE=0, CS=0, MSB=1
test_sm[] = 7;
			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			msb_ff.d = Vcc;
			sm = WE0_CS0_MSBb;

		WHEN WE0_CS0_MSBb =>
			-- WE=0, CS=0, MSB=1
test_sm[] = 8;
			data_bus_out_ff.d = Vcc;
			we_n_ff.d = Gnd;
			msb_ff.d = Vcc;
			sm = WE0_CS0_MSBc;
			
		WHEN WE0_CS0_MSBc =>
			-- WE=0, CS=0, MSB=1
test_sm[] = 9;
			data_bus_out_ff.d = Vcc;
			msb_ff.d = Vcc;
			sm = WE1_CS0_MSBb;
			
		WHEN WE1_CS0_MSBb =>
			-- WE=1, CS=0, MSB=1
test_sm[] = 10;
			addr_inc_write = Vcc;
			sm = WAIT_END;

		WHEN WAIT_END =>
test_sm[] = 11;
			store_crc_ok = Vcc;
			if store_crc then
				cs_n_ff.d = Vcc;
				sm = WAIT_END;
			else
				cs_n_ff.d = Vcc;
				sm = WAIT_STORE_CRC;
			end if;
	END CASE;

	-- Sync outs
	cs_n = cs_n_ff.q;
	we_n = we_n_ff.q;
	data_bus_out = data_bus_out_ff.q;
	msb = msb_ff.q;
end;